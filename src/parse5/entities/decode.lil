import { fromCodePoint } from "../common/unicode.lil";
import { replaceCodePoint } from "./decode-codepoint.lil";
import { htmlDecodeData } from "./generated/decode-data-html.lil";
import { xmlDecodeData } from "./generated/decode-data-xml.lil";
import { Number, String } from "../../unified/host.lil";

export enum DecodingMode { Legacy, Strict, Attribute }
enum EntityDecoderState { EntityStart, NumericStart, NumericDecimal, NumericHex, NamedEntity }

int VALUE_LENGTH = 49152;
int BRANCH_LENGTH = 16256;
int JUMP_TABLE = 127;
int VALUE_MASK = 16383;

pure bool isNumber(int code) {
  return code >= 48 && code <= 57;
}

pure bool isHexadecimalCharacter(int code) {
  return (code >= 65 && code <= 70) || (code >= 97 && code <= 102);
}

pure bool isAsciiAlphaNumeric(int code) {
  return (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || isNumber(code);
}

pure bool isEntityInAttributeInvalidEnd(int code) {
  return code == 61 || isAsciiAlphaNumeric(code);
}

export pure int determineBranch(int[] decodeTree, int current, int nodeIndex, int character) {
  int branchCount = (current & BRANCH_LENGTH) >> 7;
  int jumpOffset = current & JUMP_TABLE;
  if (branchCount == 0) {
    if (jumpOffset != 0 && character == jumpOffset) return nodeIndex;
    return -1;
  }
  if (jumpOffset != 0) {
    int value = character - jumpOffset;
    if (value < 0 || value >= branchCount) return -1;
    return decodeTree[nodeIndex + value] - 1;
  }
  int low = nodeIndex;
  int high = low + branchCount - 1;
  while (low <= high) {
    int middle = (low + high) >>> 1;
    int middleValue = decodeTree[middle];
    if (middleValue < character) {
      low = middle + 1;
    } else if (middleValue > character) {
      high = middle - 1;
    } else {
      return decodeTree[middle + branchCount];
    }
  }
  return -1;
}

export class EntityDecoder {
  int[] decodeTree;
  func(int, int)->void emitCodePoint;
  // Entity diagnostics are part of the public parse-error boundary.
  JsValue errors;
  EntityDecoderState state;
  int consumed;
  int result;
  int treeIndex;
  int excess;
  DecodingMode decodeMode;
  bool numericResultIsNaN;

  init(int[] decodeTree, func(int, int)->void emitCodePoint, JsValue errors) {
    this.decodeTree = decodeTree;
    this.emitCodePoint = emitCodePoint;
    this.errors = errors;
    this.state = EntityDecoderState.EntityStart;
    this.consumed = 1;
    this.result = 0;
    this.treeIndex = 0;
    this.excess = 1;
    this.decodeMode = DecodingMode.Strict;
    this.numericResultIsNaN = false;
  }

  void startEntity(DecodingMode decodeMode) {
    this.decodeMode = decodeMode;
    this.state = EntityDecoderState.EntityStart;
    this.result = 0;
    this.treeIndex = 0;
    this.excess = 1;
    this.consumed = 1;
    this.numericResultIsNaN = false;
  }

  void missingSemicolon() {
    if (!(JS.isUndefined(this.errors) || JS.isNullish(this.errors))) {
      JS.invoke(this.errors, "missingSemicolonAfterCharacterReference");
    }
  }

  void absenceOfDigits(int consumed) {
    if (!(JS.isUndefined(this.errors) || JS.isNullish(this.errors))) {
      JS.invoke(this.errors, "absenceOfDigitsInNumericCharacterReference", consumed);
    }
  }

  void validateNumeric(int codePoint) {
    if (!(JS.isUndefined(this.errors) || JS.isNullish(this.errors))) {
      JS.invoke(this.errors, "validateNumericCharacterReference", codePoint);
    }
  }

  void addToNumericResult(string input, int start, int end, int base) {
    int digitCount = end - start;
    if (this.result == 0 && ((base == 16 && digitCount >= 256) || (base == 10 && digitCount >= 309))) this.numericResultIsNaN = true;
    int i = start;
    while (i < end) {
      int code = input.charCodeAt(i);
      int digit = code - 48;
      if (code >= 65 && code <= 70) digit = code - 55;
      if (code >= 97 && code <= 102) digit = code - 87;
      if (this.result <= 1114111) {
        this.result = this.result * base + digit;
        if (this.result > 1114111) this.result = 1114112;
      }
      i = i + 1;
    }
    this.consumed = this.consumed + end - start;
  }

  int emitNumericEntity(int lastCodePoint, int expectedLength) {
    if (this.consumed <= expectedLength) {
      this.absenceOfDigits(this.consumed);
      return 0;
    }
    if (lastCodePoint == 59) {
      this.consumed = this.consumed + 1;
    } else if (this.decodeMode == DecodingMode.Strict) {
      return 0;
    }
    if (this.numericResultIsNaN) JS.invoke(String, "fromCodePoint", JS.get(Number, "NaN"));
    this.emitCodePoint(replaceCodePoint(this.result), this.consumed);
    if (!(JS.isUndefined(this.errors) || JS.isNullish(this.errors))) {
      if (lastCodePoint != 59) this.missingSemicolon();
      this.validateNumeric(this.result);
    }
    return this.consumed;
  }

  int emitNamedEntityData(int result, int valueLength, int consumed) {
    if (valueLength == 1) {
      this.emitCodePoint(this.decodeTree[result] & VALUE_MASK, consumed);
    } else {
      this.emitCodePoint(this.decodeTree[result + 1], consumed);
    }
    if (valueLength == 3) {
      this.emitCodePoint(this.decodeTree[result + 2], consumed);
    }
    return consumed;
  }

  int emitNotTerminatedNamedEntity() {
    int valueLength = (this.decodeTree[this.result] & VALUE_LENGTH) >> 14;
    this.emitNamedEntityData(this.result, valueLength, this.consumed);
    this.missingSemicolon();
    return this.consumed;
  }

  int stateNumericStart(string input, int offset) {
    if (offset >= input.length) return -1;
    if ((input.charCodeAt(offset) | 32) == 120) {
      this.state = EntityDecoderState.NumericHex;
      this.consumed = this.consumed + 1;
      return this.stateNumericHex(input, offset + 1);
    }
    this.state = EntityDecoderState.NumericDecimal;
    return this.stateNumericDecimal(input, offset);
  }

  int stateNumericHex(string input, int offset) {
    int start = offset;
    while (offset < input.length) {
      int code = input.charCodeAt(offset);
      if (isNumber(code) || isHexadecimalCharacter(code)) {
        offset = offset + 1;
      } else {
        this.addToNumericResult(input, start, offset, 16);
        return this.emitNumericEntity(code, 3);
      }
    }
    this.addToNumericResult(input, start, offset, 16);
    return -1;
  }

  int stateNumericDecimal(string input, int offset) {
    int start = offset;
    while (offset < input.length) {
      int code = input.charCodeAt(offset);
      if (isNumber(code)) {
        offset = offset + 1;
      } else {
        this.addToNumericResult(input, start, offset, 10);
        return this.emitNumericEntity(code, 2);
      }
    }
    this.addToNumericResult(input, start, offset, 10);
    return -1;
  }

  int stateNamedEntity(string input, int offset) {
    int current = this.decodeTree[this.treeIndex];
    int valueLength = (current & VALUE_LENGTH) >> 14;
    while (offset < input.length) {
      int character = input.charCodeAt(offset);
      int skip = valueLength;
      if (skip < 1) skip = 1;
      this.treeIndex = determineBranch(this.decodeTree, current, this.treeIndex + skip, character);
      if (this.treeIndex < 0) {
        if (this.result == 0 || (this.decodeMode == DecodingMode.Attribute && (valueLength == 0 || isEntityInAttributeInvalidEnd(character)))) {
          return 0;
        }
        return this.emitNotTerminatedNamedEntity();
      }
      current = this.decodeTree[this.treeIndex];
      valueLength = (current & VALUE_LENGTH) >> 14;
      if (valueLength != 0) {
        if (character == 59) {
          return this.emitNamedEntityData(this.treeIndex, valueLength, this.consumed + this.excess);
        }
        if (this.decodeMode != DecodingMode.Strict) {
          this.result = this.treeIndex;
          this.consumed = this.consumed + this.excess;
          this.excess = 0;
        }
      }
      offset = offset + 1;
      this.excess = this.excess + 1;
    }
    return -1;
  }

  int write(string input, int offset) {
    if (this.state == EntityDecoderState.EntityStart) {
      if (input.charCodeAt(offset) == 35) {
        this.state = EntityDecoderState.NumericStart;
        this.consumed = this.consumed + 1;
        return this.stateNumericStart(input, offset + 1);
      }
      this.state = EntityDecoderState.NamedEntity;
      return this.stateNamedEntity(input, offset);
    }
    if (this.state == EntityDecoderState.NumericStart) return this.stateNumericStart(input, offset);
    if (this.state == EntityDecoderState.NumericDecimal) return this.stateNumericDecimal(input, offset);
    if (this.state == EntityDecoderState.NumericHex) return this.stateNumericHex(input, offset);
    return this.stateNamedEntity(input, offset);
  }

  int end() {
    if (this.state == EntityDecoderState.NamedEntity) {
      if (this.result != 0 && (this.decodeMode != DecodingMode.Attribute || this.result == this.treeIndex)) {
        return this.emitNotTerminatedNamedEntity();
      }
      return 0;
    }
    if (this.state == EntityDecoderState.NumericDecimal) return this.emitNumericEntity(0, 2);
    if (this.state == EntityDecoderState.NumericHex) return this.emitNumericEntity(0, 3);
    if (this.state == EntityDecoderState.NumericStart) this.absenceOfDigits(this.consumed);
    return 0;
  }
}

class StringOutput {
  string value;
}

string decodeWithTree(int[] tree, string input, DecodingMode mode) {
  StringOutput output = new StringOutput();
  output.value = "";
  EntityDecoder decoder = new EntityDecoder(tree, (int codePoint, int _consumed) => {
    output.value = output.value + fromCodePoint(codePoint);
  }, JS.undefined());
  int lastIndex = 0;
  int offset = 0;
  while (offset < input.length) {
    if (input.charAt(offset) != "&") {
      offset = offset + 1;
      continue;
    }
    output.value = output.value + input.slice(lastIndex, offset);
    decoder.startEntity(mode);
    int length = decoder.write(input, offset + 1);
    if (length < 0) {
      lastIndex = offset + decoder.end();
      offset = input.length;
    } else {
      lastIndex = offset + length;
      if (length == 0) {
        offset = lastIndex + 1;
      } else {
        offset = lastIndex;
      }
    }
  }
  string result = output.value + input.slice(lastIndex);
  output.value = "";
  return result;
}

export string decodeHTML(string input, DecodingMode mode) {
  return decodeWithTree(htmlDecodeData, input, mode);
}

export string decodeHTMLAttribute(string input) {
  return decodeWithTree(htmlDecodeData, input, DecodingMode.Attribute);
}

export string decodeHTMLStrict(string input) {
  return decodeWithTree(htmlDecodeData, input, DecodingMode.Strict);
}

export string decodeXML(string input) {
  return decodeWithTree(xmlDecodeData, input, DecodingMode.Strict);
}
