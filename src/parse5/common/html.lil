initSets();

bool tableHas(bool[] table, int id) {
  if (id < 0 || id >= table.length) {
    return false;
  }
  return table[id];
}

export bool isSpecial(string ns, int tagId) {
  if (ns == NS_HTML) {
    return tableHas(htmlSpecial, tagId);
  }
  if (ns == NS_MATHML) {
    return tableHas(mathSpecial, tagId);
  }
  if (ns == NS_SVG) {
    return tableHas(svgSpecial, tagId);
  }
  return false;
}

export bool isNumberedHeader(int tagId) {
  return tableHas(numberedHeaders, tagId);
}

export bool hasUnescapedText(string tn, bool scriptingEnabled) {
  if (tn == "style" || tn == "script" || tn == "xmp" || tn == "iframe" || tn == "noembed" || tn == "noframes" || tn == "plaintext") {
    return true;
  }
  return scriptingEnabled && tn == "noscript";
}
