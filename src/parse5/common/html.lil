export pure bool isSpecial(Namespace ns, TagId id) {
  if (ns == Namespace.MathMl) {
    return id == TagId.Mi || id == TagId.Mo || id == TagId.Mn || id == TagId.Ms || id == TagId.Mtext || id == TagId.AnnotationXml;
  }
  if (ns == Namespace.Svg) {
    return id == TagId.Title || id == TagId.ForeignObject || id == TagId.Desc;
  }
  if (ns != Namespace.Html) {
    return false;
  }
  return id == TagId.Address || id == TagId.Applet || id == TagId.Area || id == TagId.Article || id == TagId.Aside || id == TagId.Base || id == TagId.Basefont || id == TagId.Bgsound || id == TagId.Blockquote || id == TagId.Body || id == TagId.Br || id == TagId.Button || id == TagId.Caption || id == TagId.Center || id == TagId.Col || id == TagId.Colgroup || id == TagId.Dd || id == TagId.Details || id == TagId.Dir || id == TagId.Div || id == TagId.Dl || id == TagId.Dt || id == TagId.Embed || id == TagId.Fieldset || id == TagId.Figcaption || id == TagId.Figure || id == TagId.Footer || id == TagId.Form || id == TagId.Frame || id == TagId.Frameset || id == TagId.H1 || id == TagId.H2 || id == TagId.H3 || id == TagId.H4 || id == TagId.H5 || id == TagId.H6 || id == TagId.Head || id == TagId.Header || id == TagId.Hgroup || id == TagId.Hr || id == TagId.Html || id == TagId.Iframe || id == TagId.Img || id == TagId.Input || id == TagId.Li || id == TagId.Link || id == TagId.Listing || id == TagId.Main || id == TagId.Marquee || id == TagId.Menu || id == TagId.Meta || id == TagId.Nav || id == TagId.Noembed || id == TagId.Noframes || id == TagId.Noscript || id == TagId.Object || id == TagId.Ol || id == TagId.P || id == TagId.Param || id == TagId.Plaintext || id == TagId.Pre || id == TagId.Script || id == TagId.Section || id == TagId.Select || id == TagId.Source || id == TagId.Style || id == TagId.Summary || id == TagId.Table || id == TagId.Tbody || id == TagId.Td || id == TagId.Template || id == TagId.Textarea || id == TagId.Tfoot || id == TagId.Th || id == TagId.Thead || id == TagId.Title || id == TagId.Tr || id == TagId.Track || id == TagId.Ul || id == TagId.Wbr || id == TagId.Xmp;
}

export pure bool isNumberedHeader(TagId id) {
  return id == TagId.H1 || id == TagId.H2 || id == TagId.H3 || id == TagId.H4 || id == TagId.H5 || id == TagId.H6;
}

export pure bool hasUnescapedText(string name, bool scriptingEnabled) {
  return name == "style" || name == "script" || name == "xmp" || name == "iframe" || name == "noembed" || name == "noframes" || name == "plaintext" || (scriptingEnabled && name == "noscript");
}
