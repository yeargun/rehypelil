export enum Namespace { Html, MathMl, Svg, XLink, Xml, Xmlns }

export pure string namespaceUri(Namespace ns) {
  if (ns == Namespace.Html) return "http://www.w3.org/1999/xhtml";
  if (ns == Namespace.MathMl) return "http://www.w3.org/1998/Math/MathML";
  if (ns == Namespace.Svg) return "http://www.w3.org/2000/svg";
  if (ns == Namespace.XLink) return "http://www.w3.org/1999/xlink";
  if (ns == Namespace.Xml) return "http://www.w3.org/XML/1998/namespace";
  return "http://www.w3.org/2000/xmlns/";
}

export enum DocumentMode { NoQuirks, Quirks, LimitedQuirks }

export pure string documentModeName(DocumentMode mode) {
  if (mode == DocumentMode.Quirks) return "quirks";
  if (mode == DocumentMode.LimitedQuirks) return "limited-quirks";
  return "no-quirks";
}

