export int getTagID(string tagName) {
  JsValue id = TAG_NAME_TO_ID[tagName];
  if (JS.isUndefined(id)) {
    return 0;
  }
  return JS.number(id).toInt();
}

bool[] htmlSpecial = [];
bool[] mathSpecial = [];
bool[] svgSpecial = [];
bool[] numberedHeaders = [];

void grow(bool[] table, int id) {
  while (table.length <= id) {
    table.push(false);
  }
}

void mark(bool[] table, int id) {
  grow(table, id);
  table[id] = true;
}

