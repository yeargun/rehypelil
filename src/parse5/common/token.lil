import { TagId } from "./html.lil";

export enum TokenType {
  Character,
  NullCharacter,
  WhitespaceCharacter,
  StartTag,
  EndTag,
  Comment,
  Doctype,
  Eof,
  Hibernation
}

export class Attribute {
  string name;
  string value;
  string? namespace;
  string? prefix;

  init(string name, string value, string? namespace, string? prefix) {
    this.name = name;
    this.value = value;
    this.namespace = namespace;
    this.prefix = prefix;
  }
}

export class Location {
  int startLine;
  int startCol;
  int startOffset;
  int endLine;
  int endCol;
  int endOffset;
}

export class TagLocation extends Location {
  Map<string, Location> attrs;
}

export class DoctypeToken {
  TokenType type;
  string? name;
  bool forceQuirks;
  string? publicId;
  string? systemId;
  Location? location;

  init(TokenType type, string? name, bool forceQuirks, string? publicId, string? systemId, Location? location) {
    this.type = type;
    this.name = name;
    this.forceQuirks = forceQuirks;
    this.publicId = publicId;
    this.systemId = systemId;
    this.location = location;
  }
}

export class TagToken {
  TokenType type;
  string tagName;
  TagId tagID;
  bool selfClosing;
  bool ackSelfClosing;
  Attribute[] attrs;
  TagLocation? location;
  JsValue serializedLocation;

  init(TokenType type, string tagName, TagId tagID, bool selfClosing, bool ackSelfClosing, Attribute[] attrs, TagLocation? location, JsValue serializedLocation) {
    this.type = type;
    this.tagName = tagName;
    this.tagID = tagID;
    this.selfClosing = selfClosing;
    this.ackSelfClosing = ackSelfClosing;
    this.attrs = attrs;
    this.location = location;
    this.serializedLocation = serializedLocation;
  }
}

export class CommentToken {
  TokenType type;
  string data;
  Location? location;

  init(TokenType type, string data, Location? location) {
    this.type = type;
    this.data = data;
    this.location = location;
  }
}

export class CharacterToken {
  TokenType type;
  string chars;
  Location? location;

  init(TokenType type, string chars, Location? location) {
    this.type = type;
    this.chars = chars;
    this.location = location;
  }
}

export class EofToken {
  TokenType type;
  Location? location;

  init(TokenType type, Location? location) {
    this.type = type;
    this.location = location;
  }
}

export pure string? getTokenAttr(TagToken token, string attrName) {
  int i = token.attrs.length - 1;
  while (i >= 0) {
    if (token.attrs[i].name == attrName) {
      return token.attrs[i].value;
    }
    i = i - 1;
  }
  return null;
}
