import { TagId } from "./html.lil";

export enum TokenType {
  Character,
  NullCharacter,
  WhitespaceCharacter,
  StartTag,
  EndTag,
  Comment,
  Doctype,
  Eof,
  Hibernation
}

export struct Attribute {
  string name;
  string value;
  string? namespace;
  string? prefix;
}

export class Location {
  int startLine;
  int startCol;
  int startOffset;
  int endLine;
  int endCol;
  int endOffset;
}

export class TagLocation extends Location {
  Map<string, Location> attrs;
}

export struct DoctypeToken {
  TokenType type;
  string? name;
  bool forceQuirks;
  string? publicId;
  string? systemId;
  Location? location;
}

export struct TagToken {
  TokenType type;
  string tagName;
  TagId tagID;
  bool selfClosing;
  bool ackSelfClosing;
  Attribute[] attrs;
  TagLocation? location;
  JsValue serializedLocation;
}

export struct CommentToken {
  TokenType type;
  string data;
  Location? location;
}

export struct CharacterToken {
  TokenType type;
  string chars;
  Location? location;
}

export struct EofToken {
  TokenType type;
  Location? location;
}

export pure string? getTokenAttr(TagToken token, string attrName) {
  int i = token.attrs.length - 1;
  while (i >= 0) {
    if (token.attrs[i].name == attrName) {
      return token.attrs[i].value;
    }
    i = i - 1;
  }
  return null;
}
