import { ErrorCode, ParserError, parserErrorValue } from "../common/error-codes.lil";
import { CARRIAGE_RETURN, EOF, LINE_FEED, getSurrogatePairCodePoint, isControlCodePoint, isSurrogate, isSurrogatePair, isUndefinedCodePoint } from "../common/unicode.lil";

int DEFAULT_BUFFER_WATERLINE = 65536;

export class Preprocessor {
  // The callback is intentionally dynamic: parse errors are a public boundary.
  JsValue handler;
  string html;
  int pos;
  int lastGapPos;
  int[] gapStack;
  bool skipNextNewLine;
  bool lastChunkWritten;
  bool endOfChunkHit;
  int bufferWaterline;
  bool isEol;
  int lineStartPos;
  int droppedBufferSize;
  int line;
  int lastErrOffset;

  init(JsValue handler) {
    this.handler = handler;
    this.html = "";
    this.pos = -1;
    this.lastGapPos = -2;
    this.gapStack = [];
    this.skipNextNewLine = false;
    this.lastChunkWritten = false;
    this.endOfChunkHit = false;
    this.bufferWaterline = DEFAULT_BUFFER_WATERLINE;
    this.isEol = false;
    this.lineStartPos = 0;
    this.droppedBufferSize = 0;
    this.line = 1;
    this.lastErrOffset = -1;
  }

  int col() {
    int gap = 1;
    if (this.lastGapPos == this.pos) gap = 0;
    return this.pos - this.lineStartPos + gap;
  }

  int offset() {
    return this.droppedBufferSize + this.pos;
  }

  ParserError getError(ErrorCode code, int cpOffset) {
    int startCol = this.col() + cpOffset;
    int startOffset = this.offset() + cpOffset;
    return ParserError{code, this.line, this.line, startCol, startCol, startOffset, startOffset};
  }

  void err(ErrorCode code) {
    JsValue onParseError = JS.get(this.handler, "onParseError");
    if (JS.isUndefined(onParseError) || JS.isNullish(onParseError) || this.lastErrOffset == this.offset()) {
      return;
    }
    this.lastErrOffset = this.offset();
    JS.call(onParseError, this.handler, parserErrorValue(this.getError(code, 0)));
  }

  void addGap() {
    this.gapStack.push(this.lastGapPos);
    this.lastGapPos = this.pos;
  }

  int processSurrogate(int cp) {
    if (this.pos != this.html.length - 1) {
      int nextCp = this.html.charCodeAt(this.pos + 1);
      if (isSurrogatePair(nextCp)) {
        this.pos = this.pos + 1;
        this.addGap();
        return getSurrogatePairCodePoint(cp, nextCp);
      }
    } else if (!this.lastChunkWritten) {
      this.endOfChunkHit = true;
      return EOF;
    }
    this.err(ErrorCode.SurrogateInInputStream);
    return cp;
  }

  bool willDropParsedChunk() {
    return this.pos > this.bufferWaterline;
  }

  void dropParsedChunk() {
    if (this.willDropParsedChunk()) {
      this.html = this.html.slice(this.pos);
      this.lineStartPos = this.lineStartPos - this.pos;
      this.droppedBufferSize = this.droppedBufferSize + this.pos;
      this.pos = 0;
      this.lastGapPos = -2;
      this.gapStack = [];
    }
  }

  void write(string chunk, bool isLastChunk) {
    if (this.html.length > 0) {
      this.html = this.html + chunk;
    } else {
      this.html = chunk;
    }
    this.endOfChunkHit = false;
    this.lastChunkWritten = isLastChunk;
  }

  void insertHtmlAtCurrentPos(string chunk) {
    this.html = this.html.slice(0, this.pos + 1) + chunk + this.html.slice(this.pos + 1);
    this.endOfChunkHit = false;
  }

  bool startsWith(string pattern, bool caseSensitive) {
    if (this.pos + pattern.length > this.html.length) {
      this.endOfChunkHit = !this.lastChunkWritten;
      return false;
    }
    if (caseSensitive) {
      return this.html.slice(this.pos, this.pos + pattern.length) == pattern;
    }
    int i = 0;
    while (i < pattern.length) {
      if ((this.html.charCodeAt(this.pos + i) | 32) != pattern.charCodeAt(i)) {
        return false;
      }
      i = i + 1;
    }
    return true;
  }

  int peek(int relativeOffset) {
    int position = this.pos + relativeOffset;
    if (position >= this.html.length) {
      this.endOfChunkHit = !this.lastChunkWritten;
      return EOF;
    }
    int code = this.html.charCodeAt(position);
    if (code == CARRIAGE_RETURN) return LINE_FEED;
    return code;
  }

  int advance() {
    this.pos = this.pos + 1;
    if (this.isEol) {
      this.isEol = false;
      this.line = this.line + 1;
      this.lineStartPos = this.pos;
    }
    if (this.pos >= this.html.length) {
      this.endOfChunkHit = !this.lastChunkWritten;
      return EOF;
    }
    int cp = this.html.charCodeAt(this.pos);
    if (cp == CARRIAGE_RETURN) {
      this.isEol = true;
      this.skipNextNewLine = true;
      return LINE_FEED;
    }
    if (cp == LINE_FEED) {
      this.isEol = true;
      if (this.skipNextNewLine) {
        this.line = this.line - 1;
        this.skipNextNewLine = false;
        this.addGap();
        return this.advance();
      }
    }
    this.skipNextNewLine = false;
    if (isSurrogate(cp)) {
      cp = this.processSurrogate(cp);
    }
    JsValue onParseError = JS.get(this.handler, "onParseError");
    bool noErrors = JS.isUndefined(onParseError) || JS.isNullish(onParseError);
    bool commonValidRange = noErrors || (cp > 31 && cp < 127) || cp == LINE_FEED || cp == CARRIAGE_RETURN || (cp > 159 && cp < 64976);
    if (!commonValidRange) {
      this.checkForProblematicCharacters(cp);
    }
    return cp;
  }

  void checkForProblematicCharacters(int cp) {
    if (isControlCodePoint(cp)) {
      this.err(ErrorCode.ControlCharacterInInputStream);
    } else if (isUndefinedCodePoint(cp)) {
      this.err(ErrorCode.NoncharacterInInputStream);
    }
  }

  void retreat(int count) {
    this.pos = this.pos - count;
    while (this.pos < this.lastGapPos) {
      this.lastGapPos = this.gapStack.pop();
      this.pos = this.pos - 1;
    }
    this.isEol = false;
  }
}
