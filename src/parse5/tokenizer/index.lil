import { JSON, Object, throwError } from "../../unified/host.lil";
import { ErrorCode, parserErrorValue } from "../common/error-codes.lil";
import { TagId, getTagID } from "../common/html.lil";
import { Attribute, CharacterToken, CommentToken, DoctypeToken, EofToken, Location, TagLocation, TagToken, TokenType, getTokenAttr } from "../common/token.lil";
import {
  AMPERSAND, APOSTROPHE, CDATA_START, CARRIAGE_RETURN, DIGIT_0, DIGIT_9,
  DOCTYPE, EOF, EQUALS_SIGN, EXCLAMATION_MARK, FORM_FEED, GRAVE_ACCENT,
  GREATER_THAN_SIGN, HYPHEN_MINUS, LATIN_CAPITAL_A, LATIN_CAPITAL_Z,
  LATIN_SMALL_A, LATIN_SMALL_Z, LESS_THAN_SIGN, LINE_FEED, NULL, PUBLIC,
  QUESTION_MARK, QUOTATION_MARK, REPLACEMENT_CHARACTER, RIGHT_SQUARE_BRACKET,
  SCRIPT, SEMICOLON, SOLIDUS, SPACE, SYSTEM, TABULATION, DASH_DASH,
  fromCodePoint, isControlCodePoint, isSurrogate, isUndefinedCodePoint
} from "../common/unicode.lil";
import { DecodingMode, EntityDecoder } from "../entities/decode.lil";
import { htmlDecodeData } from "../entities/generated/decode-data-html.lil";
import { Preprocessor } from "./preprocessor.lil";

export enum State {
  Data,
  Rcdata,
  Rawtext,
  ScriptData,
  Plaintext,
  TagOpen,
  EndTagOpen,
  TagName,
  RcdataLessThanSign,
  RcdataEndTagOpen,
  RcdataEndTagName,
  RawtextLessThanSign,
  RawtextEndTagOpen,
  RawtextEndTagName,
  ScriptDataLessThanSign,
  ScriptDataEndTagOpen,
  ScriptDataEndTagName,
  ScriptDataEscapeStart,
  ScriptDataEscapeStartDash,
  ScriptDataEscaped,
  ScriptDataEscapedDash,
  ScriptDataEscapedDashDash,
  ScriptDataEscapedLessThanSign,
  ScriptDataEscapedEndTagOpen,
  ScriptDataEscapedEndTagName,
  ScriptDataDoubleEscapeStart,
  ScriptDataDoubleEscaped,
  ScriptDataDoubleEscapedDash,
  ScriptDataDoubleEscapedDashDash,
  ScriptDataDoubleEscapedLessThanSign,
  ScriptDataDoubleEscapeEnd,
  BeforeAttributeName,
  AttributeName,
  AfterAttributeName,
  BeforeAttributeValue,
  AttributeValueDoubleQuoted,
  AttributeValueSingleQuoted,
  AttributeValueUnquoted,
  AfterAttributeValueQuoted,
  SelfClosingStartTag,
  BogusComment,
  MarkupDeclarationOpen,
  CommentStart,
  CommentStartDash,
  Comment,
  CommentLessThanSign,
  CommentLessThanSignBang,
  CommentLessThanSignBangDash,
  CommentLessThanSignBangDashDash,
  CommentEndDash,
  CommentEnd,
  CommentEndBang,
  Doctype,
  BeforeDoctypeName,
  DoctypeName,
  AfterDoctypeName,
  AfterDoctypePublicKeyword,
  BeforeDoctypePublicIdentifier,
  DoctypePublicIdentifierDoubleQuoted,
  DoctypePublicIdentifierSingleQuoted,
  AfterDoctypePublicIdentifier,
  BetweenDoctypePublicAndSystemIdentifiers,
  AfterDoctypeSystemKeyword,
  BeforeDoctypeSystemIdentifier,
  DoctypeSystemIdentifierDoubleQuoted,
  DoctypeSystemIdentifierSingleQuoted,
  AfterDoctypeSystemIdentifier,
  BogusDoctype,
  CdataSection,
  CdataSectionBracket,
  CdataSectionEnd,
  CharacterReference,
  AmbiguousAmpersand
}

export int MODE_DATA = 0;
export int MODE_RCDATA = 1;
export int MODE_RAWTEXT = 2;
export int MODE_SCRIPT_DATA = 3;
export int MODE_PLAINTEXT = 4;
export int MODE_CDATA_SECTION = 68;

export struct TypedTokenHandler {
  func(CommentToken)->void onComment;
  func(DoctypeToken)->void onDoctype;
  func(TagToken)->void onStartTag;
  func(TagToken)->void onEndTag;
  func(EofToken)->void onEof;
  func(CharacterToken)->void onCharacter;
  func(CharacterToken)->void onNullCharacter;
  func(CharacterToken)->void onWhitespaceCharacter;
}

pure bool isAsciiDigit(int cp) {
  return cp >= DIGIT_0 && cp <= DIGIT_9;
}

pure bool isAsciiUpper(int cp) {
  return cp >= LATIN_CAPITAL_A && cp <= LATIN_CAPITAL_Z;
}

pure bool isAsciiLower(int cp) {
  return cp >= LATIN_SMALL_A && cp <= LATIN_SMALL_Z;
}

pure bool isAsciiLetter(int cp) {
  return isAsciiLower(cp) || isAsciiUpper(cp);
}

pure bool isAsciiAlphaNumeric(int cp) {
  return isAsciiLetter(cp) || isAsciiDigit(cp);
}

pure int toAsciiLower(int cp) {
  return cp + 32;
}

pure bool isWhitespace(int cp) {
  return cp == SPACE || cp == LINE_FEED || cp == TABULATION || cp == FORM_FEED;
}

pure bool isScriptDataDoubleEscapeSequenceEnd(int cp) {
  return isWhitespace(cp) || cp == SOLIDUS || cp == GREATER_THAN_SIGN;
}

pure ErrorCode? getErrorForNumericCharacterReference(int code) {
  if (code == NULL) return ErrorCode.NullCharacterReference;
  if (code > 1114111) return ErrorCode.CharacterReferenceOutsideUnicodeRange;
  if (isSurrogate(code)) return ErrorCode.SurrogateCharacterReference;
  if (isUndefinedCodePoint(code)) return ErrorCode.NoncharacterCharacterReference;
  if (isControlCodePoint(code) || code == CARRIAGE_RETURN) return ErrorCode.ControlCharacterReference;
  return null;
}

Location locationFromPreprocessor(Preprocessor preprocessor, int offset) {
  Location location = new Location();
  location.startLine = preprocessor.line;
  location.startCol = preprocessor.col() - offset;
  location.startOffset = preprocessor.offset() - offset;
  location.endLine = -1;
  location.endCol = -1;
  location.endOffset = -1;
  return location;
}

TagLocation tagLocationFromPreprocessor(Preprocessor preprocessor, int offset) {
  TagLocation location = new TagLocation();
  location.startLine = preprocessor.line;
  location.startCol = preprocessor.col() - offset;
  location.startOffset = preprocessor.offset() - offset;
  location.endLine = -1;
  location.endCol = -1;
  location.endOffset = -1;
  location.attrs = new Map<string, Location>();
  return location;
}

// Token objects become plain JavaScript data only at the handler boundary.
export JsValue locationValue(Location? location) {
  if (location == null) return JS.invoke(JSON, "parse", "null");
  return JS.object(
    "startLine", location.startLine,
    "startCol", location.startCol,
    "startOffset", location.startOffset,
    "endLine", location.endLine,
    "endCol", location.endCol,
    "endOffset", location.endOffset
  );
}

export JsValue tagLocationValue(TagLocation? location, Attribute[] attrs) {
  if (location == null) return JS.invoke(JSON, "parse", "null");
  JsValue value = JS.object(
    "startLine", location.startLine,
    "startCol", location.startCol,
    "startOffset", location.startOffset,
    "endLine", location.endLine,
    "endCol", location.endCol,
    "endOffset", location.endOffset
  );
  if (attrs.length > 0) {
    JsValue locations = JS.invoke(Object, "create", JS.invoke(JSON, "parse", "null"));
    int i = 0;
    while (i < attrs.length) {
      Location? attrLocation = location.attrs.get(attrs[i].name);
      if (attrLocation != null) JS.set(locations, attrs[i].name, locationValue(attrLocation));
      i = i + 1;
    }
    JS.set(value, "attrs", locations);
  }
  return value;
}

export JsValue attrsValue(Attribute[] attrs) {
  JsValue value = JS.array();
  int i = 0;
  while (i < attrs.length) {
    Attribute attr = attrs[i];
    JsValue item = JS.object("name", attr.name, "value", attr.value);
    if (attr.namespace != null) JS.set(item, "namespace", attr.namespace);
    if (attr.prefix != null) JS.set(item, "prefix", attr.prefix);
    JS.push(value, item);
    i = i + 1;
  }
  return value;
}

JsValue tagTokenValue(TagToken token) {
  return JS.object(
    "type", token.type,
    "tagName", token.tagName,
    "tagID", token.tagID,
    "selfClosing", token.selfClosing,
    "ackSelfClosing", token.ackSelfClosing,
    "attrs", attrsValue(token.attrs),
    "location", tagLocationValue(token.location, token.attrs)
  );
}

JsValue commentTokenValue(CommentToken token) {
  return JS.object("type", token.type, "data", token.data, "location", locationValue(token.location));
}

JsValue doctypeTokenValue(DoctypeToken token) {
  return JS.object(
    "type", token.type,
    "name", token.name,
    "forceQuirks", token.forceQuirks,
    "publicId", token.publicId,
    "systemId", token.systemId,
    "location", locationValue(token.location)
  );
}

JsValue characterTokenValue(CharacterToken token) {
  return JS.object("type", token.type, "chars", token.chars, "location", locationValue(token.location));
}

JsValue eofTokenValue(EofToken token) {
  return JS.object("type", token.type, "location", locationValue(token.location));
}

export TypedTokenHandler adaptTokenHandler(JsValue handler) {
  return TypedTokenHandler{
    (CommentToken token) => { JS.invoke(handler, "onComment", commentTokenValue(token)); },
    (DoctypeToken token) => { JS.invoke(handler, "onDoctype", doctypeTokenValue(token)); },
    (TagToken token) => { JS.invoke(handler, "onStartTag", tagTokenValue(token)); },
    (TagToken token) => { JS.invoke(handler, "onEndTag", tagTokenValue(token)); },
    (EofToken token) => { JS.invoke(handler, "onEof", eofTokenValue(token)); },
    (CharacterToken token) => { JS.invoke(handler, "onCharacter", characterTokenValue(token)); },
    (CharacterToken token) => { JS.invoke(handler, "onNullCharacter", characterTokenValue(token)); },
    (CharacterToken token) => { JS.invoke(handler, "onWhitespaceCharacter", characterTokenValue(token)); }
  };
}

export class Tokenizer {
  // Options and handler are the public JavaScript adapter boundary.
  JsValue handler;
  TypedTokenHandler typedHandler;
  bool sourceCodeLocationInfo;
  bool paused;
  bool inLoop;
  bool inForeignNode;
  string lastStartTagName;
  bool active;
  State state;
  State returnState;
  int entityStartPos;
  int consumedAfterSnapshot;
  Location? currentLocation;
  CharacterToken currentCharacterToken;
  bool hasCharacterToken;
  TagToken currentTagToken;
  CommentToken currentCommentToken;
  DoctypeToken currentDoctypeToken;
  Attribute currentAttr;
  Preprocessor preprocessor;
  EntityDecoder entityDecoder;

  init(JsValue options, JsValue handler, TypedTokenHandler typedHandler) {
    this.handler = handler;
    this.typedHandler = typedHandler;
    this.sourceCodeLocationInfo = false;
    if (!(JS.isUndefined(options) || JS.isNullish(options))) {
      this.sourceCodeLocationInfo = JS.get(options, "sourceCodeLocationInfo").truthy();
    }
    this.paused = false;
    this.inLoop = false;
    this.inForeignNode = false;
    this.lastStartTagName = "";
    this.active = false;
    this.state = State.Data;
    this.returnState = State.Data;
    this.entityStartPos = 0;
    this.consumedAfterSnapshot = -1;
    this.currentLocation = null;
    this.currentCharacterToken = CharacterToken{TokenType.Character, "", null};
    this.hasCharacterToken = false;
    this.currentTagToken = TagToken{TokenType.Character, "", TagId.Unknown, false, false, [], null, JS.undefined()};
    this.currentCommentToken = CommentToken{TokenType.Comment, "", null};
    this.currentDoctypeToken = DoctypeToken{TokenType.Doctype, null, false, null, null, null};
    this.currentAttr = Attribute{"", "", null, null};
    this.preprocessor = new Preprocessor(handler);
    this.currentLocation = this.getCurrentLocation(-1);
    Tokenizer tokenizer = this;
    JsValue onParseError = JS.get(handler, "onParseError");
    JsValue entityErrors = JS.undefined();
    if (!(JS.isUndefined(onParseError) || JS.isNullish(onParseError))) {
      entityErrors = JS.object(
        "missingSemicolonAfterCharacterReference",
        JS.method0((JsValue _self) => {
          tokenizer.err(ErrorCode.MissingSemicolonAfterCharacterReference, 1);
          return JS.undefined();
        }),
        "absenceOfDigitsInNumericCharacterReference",
        JS.method1((JsValue _self, JsValue consumed) => {
          tokenizer.err(ErrorCode.AbsenceOfDigitsInNumericCharacterReference, tokenizer.entityStartPos - tokenizer.preprocessor.pos + JS.number(consumed).toInt());
          return JS.undefined();
        }),
        "validateNumericCharacterReference",
        JS.method1((JsValue _self, JsValue codeValue) => {
          ErrorCode? error = getErrorForNumericCharacterReference(JS.number(codeValue).toInt());
          if (error != null) tokenizer.err(error, 1);
          return JS.undefined();
        })
      );
    }
    this.entityDecoder = new EntityDecoder(htmlDecodeData, (int cp, int consumed) => {
      tokenizer.onEntityEmit(cp, consumed);
    }, entityErrors);
  }

  void onEntityEmit(int cp, int consumed) {
    // Flushing can drop the parsed chunk, so update the position first.
    this.preprocessor.pos = this.entityStartPos + consumed - 1;
    this.flushCodePointConsumedAsCharacterReference(cp);
  }

  void err(ErrorCode code, int cpOffset) {
    JsValue onParseError = JS.get(this.handler, "onParseError");
    if (JS.isUndefined(onParseError) || JS.isNullish(onParseError)) return;
    JS.call(onParseError, this.handler, parserErrorValue(this.preprocessor.getError(code, cpOffset)));
  }

  Location? getCurrentLocation(int offset) {
    if (!this.sourceCodeLocationInfo) return null;
    return locationFromPreprocessor(this.preprocessor, offset);
  }

  TagLocation? getCurrentTagLocation(int offset) {
    if (!this.sourceCodeLocationInfo) return null;
    return tagLocationFromPreprocessor(this.preprocessor, offset);
  }

  void runParsingLoop() {
    if (this.inLoop) return;
    this.inLoop = true;
    while (this.active && !this.paused) {
      this.consumedAfterSnapshot = 0;
      int cp = this.consume();
      if (!this.ensureHibernation()) this.callState(cp);
    }
    this.inLoop = false;
  }

  void pause() {
    this.paused = true;
  }

  void resume(JsValue writeCallback) {
    if (!this.paused) throwError("Parser was already resumed");
    this.paused = false;
    if (this.inLoop) return;
    this.runParsingLoop();
    if (!this.paused && JS.typeOf(writeCallback) == "function") {
      JS.call(writeCallback, JS.undefined());
    }
  }

  void write(string chunk, bool isLastChunk, JsValue writeCallback) {
    this.active = true;
    this.preprocessor.write(chunk, isLastChunk);
    this.runParsingLoop();
    if (!this.paused && JS.typeOf(writeCallback) == "function") {
      JS.call(writeCallback, JS.undefined());
    }
  }

  void insertHtmlAtCurrentPos(string chunk) {
    this.active = true;
    this.preprocessor.insertHtmlAtCurrentPos(chunk);
    this.runParsingLoop();
  }

  bool ensureHibernation() {
    if (!this.preprocessor.endOfChunkHit) return false;
    this.preprocessor.retreat(this.consumedAfterSnapshot);
    this.consumedAfterSnapshot = 0;
    this.active = false;
    return true;
  }

  int consume() {
    this.consumedAfterSnapshot = this.consumedAfterSnapshot + 1;
    return this.preprocessor.advance();
  }

  void advanceBy(int count) {
    this.consumedAfterSnapshot = this.consumedAfterSnapshot + count;
    int i = 0;
    while (i < count) {
      this.preprocessor.advance();
      i = i + 1;
    }
  }

  bool consumeSequenceIfMatch(string pattern, bool caseSensitive) {
    if (!this.preprocessor.startsWith(pattern, caseSensitive)) return false;
    this.advanceBy(pattern.length - 1);
    return true;
  }

  void createStartTagToken() {
    TagToken token = TagToken{TokenType.StartTag, "", TagId.Unknown, false, false, [], this.getCurrentTagLocation(1), JS.undefined()};
    this.currentTagToken = token;
  }

  void createEndTagToken() {
    TagToken token = TagToken{TokenType.EndTag, "", TagId.Unknown, false, false, [], this.getCurrentTagLocation(2), JS.undefined()};
    this.currentTagToken = token;
  }

  void createCommentToken(int offset) {
    CommentToken token = CommentToken{TokenType.Comment, "", this.getCurrentLocation(offset)};
    this.currentCommentToken = token;
  }

  void createDoctypeToken(string? initialName) {
    DoctypeToken token = DoctypeToken{TokenType.Doctype, initialName, false, null, null, this.currentLocation};
    this.currentDoctypeToken = token;
  }

  void createCharacterToken(TokenType type, string chars) {
    CharacterToken token = CharacterToken{type, chars, this.currentLocation};
    this.currentCharacterToken = token;
    this.hasCharacterToken = true;
  }

  void createAttr(string firstCharacter) {
    this.currentAttr = Attribute{firstCharacter, "", null, null};
    this.currentLocation = this.getCurrentLocation(0);
  }

  void leaveAttrName() {
    TagToken token = this.currentTagToken;
    if (getTokenAttr(token, this.currentAttr.name) == null) {
      token.attrs.push(this.currentAttr);
      TagLocation? tokenLocation = token.location;
      Location? currentLocation = this.currentLocation;
      if (tokenLocation != null && currentLocation != null) {
        tokenLocation.attrs.set(this.currentAttr.name, currentLocation);
        this.leaveAttrValue();
      }
    } else {
      this.err(ErrorCode.DuplicateAttribute, 0);
    }
  }

  void leaveAttrValue() {
    Location? location = this.currentLocation;
    if (location == null) return;
    location.endLine = this.preprocessor.line;
    location.endCol = this.preprocessor.col();
    location.endOffset = this.preprocessor.offset();
  }

  void emitCharacterBefore(int startLine, int startCol, int startOffset, bool hasNextLocation) {
    if (!this.hasCharacterToken) return;
    Location? location = this.currentCharacterToken.location;
    if (hasNextLocation && location != null) {
      location.endLine = startLine;
      location.endCol = startCol;
      location.endOffset = startOffset;
    }
    CharacterToken token = this.currentCharacterToken;
    TypedTokenHandler typed = this.typedHandler;
    if (token.type == TokenType.Character) {
      typed.onCharacter(token);
    } else if (token.type == TokenType.NullCharacter) {
      typed.onNullCharacter(token);
    } else if (token.type == TokenType.WhitespaceCharacter) {
      typed.onWhitespaceCharacter(token);
    }
    this.hasCharacterToken = false;
  }

  void emitCurrentCharacterToken(Location? nextLocation) {
    if (nextLocation == null) {
      this.emitCharacterBefore(0, 0, 0, false);
    } else {
      this.emitCharacterBefore(nextLocation.startLine, nextLocation.startCol, nextLocation.startOffset, true);
    }
  }

  void prepareTagToken(TagToken token) {
    TagLocation? location = token.location;
    if (location == null) {
      this.emitCharacterBefore(0, 0, 0, false);
    } else {
      this.emitCharacterBefore(location.startLine, location.startCol, location.startOffset, true);
      location.endLine = this.preprocessor.line;
      location.endCol = this.preprocessor.col() + 1;
      location.endOffset = this.preprocessor.offset() + 1;
    }
    this.currentLocation = this.getCurrentLocation(-1);
  }

  void prepareCommentToken(CommentToken token) {
    this.emitCurrentCharacterToken(token.location);
    Location? location = token.location;
    if (location != null) {
      location.endLine = this.preprocessor.line;
      location.endCol = this.preprocessor.col() + 1;
      location.endOffset = this.preprocessor.offset() + 1;
    }
    this.currentLocation = this.getCurrentLocation(-1);
  }

  void prepareDoctypeToken(DoctypeToken token) {
    this.emitCurrentCharacterToken(token.location);
    Location? location = token.location;
    if (location != null) {
      location.endLine = this.preprocessor.line;
      location.endCol = this.preprocessor.col() + 1;
      location.endOffset = this.preprocessor.offset() + 1;
    }
    this.currentLocation = this.getCurrentLocation(-1);
  }

  void emitCurrentTagToken() {
    TagToken token = this.currentTagToken;
    this.prepareTagToken(token);
    token.tagID = getTagID(token.tagName);
    TypedTokenHandler typed = this.typedHandler;
    if (token.type == TokenType.StartTag) {
      this.lastStartTagName = token.tagName;
      typed.onStartTag(token);
    } else {
      if (token.attrs.length > 0) this.err(ErrorCode.EndTagWithAttributes, 0);
      if (token.selfClosing) this.err(ErrorCode.EndTagWithTrailingSolidus, 0);
      typed.onEndTag(token);
    }
    this.preprocessor.dropParsedChunk();
  }

  void emitCurrentComment() {
    CommentToken token = this.currentCommentToken;
    this.prepareCommentToken(token);
    this.typedHandler.onComment(token);
    this.preprocessor.dropParsedChunk();
  }

  void emitCurrentDoctype() {
    DoctypeToken token = this.currentDoctypeToken;
    this.prepareDoctypeToken(token);
    this.typedHandler.onDoctype(token);
    this.preprocessor.dropParsedChunk();
  }

  void emitEOFToken() {
    Location? location = this.getCurrentLocation(0);
    if (location != null) {
      location.endLine = location.startLine;
      location.endCol = location.startCol;
      location.endOffset = location.startOffset;
    }
    this.emitCurrentCharacterToken(location);
    EofToken token = EofToken{TokenType.Eof, location};
    this.typedHandler.onEof(token);
    this.active = false;
  }

  void appendCharToCurrentCharacterToken(TokenType type, string ch) {
    if (this.hasCharacterToken) {
      if (this.currentCharacterToken.type == type) {
        this.currentCharacterToken.chars = this.currentCharacterToken.chars + ch;
        return;
      }
      this.currentLocation = this.getCurrentLocation(0);
      this.emitCurrentCharacterToken(this.currentLocation);
      this.preprocessor.dropParsedChunk();
    }
    this.createCharacterToken(type, ch);
  }

  void emitCodePoint(int cp) {
    TokenType type = TokenType.Character;
    if (isWhitespace(cp)) {
      type = TokenType.WhitespaceCharacter;
    } else if (cp == NULL) {
      type = TokenType.NullCharacter;
    }
    this.appendCharToCurrentCharacterToken(type, fromCodePoint(cp));
  }

  void emitChars(string chars) {
    this.appendCharToCurrentCharacterToken(TokenType.Character, chars);
  }

  void startCharacterReference() {
    this.returnState = this.state;
    this.state = State.CharacterReference;
    this.entityStartPos = this.preprocessor.pos;
    DecodingMode mode = DecodingMode.Legacy;
    if (this.isCharacterReferenceInAttribute()) mode = DecodingMode.Attribute;
    this.entityDecoder.startEntity(mode);
  }

  bool isCharacterReferenceInAttribute() {
    return this.returnState == State.AttributeValueDoubleQuoted ||
      this.returnState == State.AttributeValueSingleQuoted ||
      this.returnState == State.AttributeValueUnquoted;
  }

  void flushCodePointConsumedAsCharacterReference(int cp) {
    if (this.isCharacterReferenceInAttribute()) {
      this.currentAttr.value = this.currentAttr.value + fromCodePoint(cp);
    } else {
      this.emitCodePoint(cp);
    }
  }

  void callState(int cp) {
    State current = this.state;
    if (current == State.Data) this.stateData(cp);
    else if (current == State.Rcdata) this.stateRcdata(cp);
    else if (current == State.Rawtext) this.stateRawtext(cp);
    else if (current == State.ScriptData) this.stateScriptData(cp);
    else if (current == State.Plaintext) this.statePlaintext(cp);
    else if (current == State.TagOpen) this.stateTagOpen(cp);
    else if (current == State.EndTagOpen) this.stateEndTagOpen(cp);
    else if (current == State.TagName) this.stateTagName(cp);
    else if (current == State.RcdataLessThanSign) this.stateRcdataLessThanSign(cp);
    else if (current == State.RcdataEndTagOpen) this.stateRcdataEndTagOpen(cp);
    else if (current == State.RcdataEndTagName) this.stateRcdataEndTagName(cp);
    else if (current == State.RawtextLessThanSign) this.stateRawtextLessThanSign(cp);
    else if (current == State.RawtextEndTagOpen) this.stateRawtextEndTagOpen(cp);
    else if (current == State.RawtextEndTagName) this.stateRawtextEndTagName(cp);
    else if (current == State.ScriptDataLessThanSign) this.stateScriptDataLessThanSign(cp);
    else if (current == State.ScriptDataEndTagOpen) this.stateScriptDataEndTagOpen(cp);
    else if (current == State.ScriptDataEndTagName) this.stateScriptDataEndTagName(cp);
    else if (current == State.ScriptDataEscapeStart) this.stateScriptDataEscapeStart(cp);
    else if (current == State.ScriptDataEscapeStartDash) this.stateScriptDataEscapeStartDash(cp);
    else if (current == State.ScriptDataEscaped) this.stateScriptDataEscaped(cp);
    else if (current == State.ScriptDataEscapedDash) this.stateScriptDataEscapedDash(cp);
    else if (current == State.ScriptDataEscapedDashDash) this.stateScriptDataEscapedDashDash(cp);
    else if (current == State.ScriptDataEscapedLessThanSign) this.stateScriptDataEscapedLessThanSign(cp);
    else if (current == State.ScriptDataEscapedEndTagOpen) this.stateScriptDataEscapedEndTagOpen(cp);
    else if (current == State.ScriptDataEscapedEndTagName) this.stateScriptDataEscapedEndTagName(cp);
    else if (current == State.ScriptDataDoubleEscapeStart) this.stateScriptDataDoubleEscapeStart(cp);
    else if (current == State.ScriptDataDoubleEscaped) this.stateScriptDataDoubleEscaped(cp);
    else if (current == State.ScriptDataDoubleEscapedDash) this.stateScriptDataDoubleEscapedDash(cp);
    else if (current == State.ScriptDataDoubleEscapedDashDash) this.stateScriptDataDoubleEscapedDashDash(cp);
    else if (current == State.ScriptDataDoubleEscapedLessThanSign) this.stateScriptDataDoubleEscapedLessThanSign(cp);
    else if (current == State.ScriptDataDoubleEscapeEnd) this.stateScriptDataDoubleEscapeEnd(cp);
    else if (current == State.BeforeAttributeName) this.stateBeforeAttributeName(cp);
    else if (current == State.AttributeName) this.stateAttributeName(cp);
    else if (current == State.AfterAttributeName) this.stateAfterAttributeName(cp);
    else if (current == State.BeforeAttributeValue) this.stateBeforeAttributeValue(cp);
    else if (current == State.AttributeValueDoubleQuoted) this.stateAttributeValueDoubleQuoted(cp);
    else if (current == State.AttributeValueSingleQuoted) this.stateAttributeValueSingleQuoted(cp);
    else if (current == State.AttributeValueUnquoted) this.stateAttributeValueUnquoted(cp);
    else if (current == State.AfterAttributeValueQuoted) this.stateAfterAttributeValueQuoted(cp);
    else if (current == State.SelfClosingStartTag) this.stateSelfClosingStartTag(cp);
    else if (current == State.BogusComment) this.stateBogusComment(cp);
    else if (current == State.MarkupDeclarationOpen) this.stateMarkupDeclarationOpen(cp);
    else if (current == State.CommentStart) this.stateCommentStart(cp);
    else if (current == State.CommentStartDash) this.stateCommentStartDash(cp);
    else if (current == State.Comment) this.stateComment(cp);
    else if (current == State.CommentLessThanSign) this.stateCommentLessThanSign(cp);
    else if (current == State.CommentLessThanSignBang) this.stateCommentLessThanSignBang(cp);
    else if (current == State.CommentLessThanSignBangDash) this.stateCommentLessThanSignBangDash(cp);
    else if (current == State.CommentLessThanSignBangDashDash) this.stateCommentLessThanSignBangDashDash(cp);
    else if (current == State.CommentEndDash) this.stateCommentEndDash(cp);
    else if (current == State.CommentEnd) this.stateCommentEnd(cp);
    else if (current == State.CommentEndBang) this.stateCommentEndBang(cp);
    else if (current == State.Doctype) this.stateDoctype(cp);
    else if (current == State.BeforeDoctypeName) this.stateBeforeDoctypeName(cp);
    else if (current == State.DoctypeName) this.stateDoctypeName(cp);
    else if (current == State.AfterDoctypeName) this.stateAfterDoctypeName(cp);
    else if (current == State.AfterDoctypePublicKeyword) this.stateAfterDoctypePublicKeyword(cp);
    else if (current == State.BeforeDoctypePublicIdentifier) this.stateBeforeDoctypePublicIdentifier(cp);
    else if (current == State.DoctypePublicIdentifierDoubleQuoted) this.stateDoctypePublicIdentifierDoubleQuoted(cp);
    else if (current == State.DoctypePublicIdentifierSingleQuoted) this.stateDoctypePublicIdentifierSingleQuoted(cp);
    else if (current == State.AfterDoctypePublicIdentifier) this.stateAfterDoctypePublicIdentifier(cp);
    else if (current == State.BetweenDoctypePublicAndSystemIdentifiers) this.stateBetweenDoctypePublicAndSystemIdentifiers(cp);
    else if (current == State.AfterDoctypeSystemKeyword) this.stateAfterDoctypeSystemKeyword(cp);
    else if (current == State.BeforeDoctypeSystemIdentifier) this.stateBeforeDoctypeSystemIdentifier(cp);
    else if (current == State.DoctypeSystemIdentifierDoubleQuoted) this.stateDoctypeSystemIdentifierDoubleQuoted(cp);
    else if (current == State.DoctypeSystemIdentifierSingleQuoted) this.stateDoctypeSystemIdentifierSingleQuoted(cp);
    else if (current == State.AfterDoctypeSystemIdentifier) this.stateAfterDoctypeSystemIdentifier(cp);
    else if (current == State.BogusDoctype) this.stateBogusDoctype(cp);
    else if (current == State.CdataSection) this.stateCdataSection(cp);
    else if (current == State.CdataSectionBracket) this.stateCdataSectionBracket(cp);
    else if (current == State.CdataSectionEnd) this.stateCdataSectionEnd(cp);
    else if (current == State.CharacterReference) this.stateCharacterReference();
    else if (current == State.AmbiguousAmpersand) this.stateAmbiguousAmpersand(cp);
    else throwError("Unknown state");
  }

  void stateData(int cp) {
    if (cp == LESS_THAN_SIGN) {
      this.state = State.TagOpen;
    } else if (cp == AMPERSAND) {
      this.startCharacterReference();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitCodePoint(cp);
    } else if (cp == EOF) {
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateRcdata(int cp) {
    if (cp == AMPERSAND) {
      this.startCharacterReference();
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.RcdataLessThanSign;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateRawtext(int cp) {
    if (cp == LESS_THAN_SIGN) {
      this.state = State.RawtextLessThanSign;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateScriptData(int cp) {
    if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataLessThanSign;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void statePlaintext(int cp) {
    if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateTagOpen(int cp) {
    if (isAsciiLetter(cp)) {
      this.createStartTagToken();
      this.state = State.TagName;
      this.stateTagName(cp);
      return;
    }
    if (cp == EXCLAMATION_MARK) {
      this.state = State.MarkupDeclarationOpen;
    } else if (cp == SOLIDUS) {
      this.state = State.EndTagOpen;
    } else if (cp == QUESTION_MARK) {
      this.err(ErrorCode.UnexpectedQuestionMarkInsteadOfTagName, 0);
      this.createCommentToken(1);
      this.state = State.BogusComment;
      this.stateBogusComment(cp);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofBeforeTagName, 0);
      this.emitChars("<");
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.InvalidFirstCharacterOfTagName, 0);
      this.emitChars("<");
      this.state = State.Data;
      this.stateData(cp);
    }
  }

  void stateEndTagOpen(int cp) {
    if (isAsciiLetter(cp)) {
      this.createEndTagToken();
      this.state = State.TagName;
      this.stateTagName(cp);
      return;
    }
    if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingEndTagName, 0);
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofBeforeTagName, 0);
      this.emitChars("</");
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.InvalidFirstCharacterOfTagName, 0);
      this.createCommentToken(2);
      this.state = State.BogusComment;
      this.stateBogusComment(cp);
    }
  }

  void stateTagName(int cp) {
    if (isWhitespace(cp)) {
      this.state = State.BeforeAttributeName;
    } else if (cp == SOLIDUS) {
      this.state = State.SelfClosingStartTag;
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentTagToken();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentTagToken.tagName = this.currentTagToken.tagName + REPLACEMENT_CHARACTER;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      int output = cp;
      if (isAsciiUpper(cp)) output = toAsciiLower(cp);
      this.currentTagToken.tagName = this.currentTagToken.tagName + fromCodePoint(output);
    }
  }

  void stateRcdataLessThanSign(int cp) {
    if (cp == SOLIDUS) {
      this.state = State.RcdataEndTagOpen;
    } else {
      this.emitChars("<");
      this.state = State.Rcdata;
      this.stateRcdata(cp);
    }
  }

  void stateRcdataEndTagOpen(int cp) {
    if (isAsciiLetter(cp)) {
      this.state = State.RcdataEndTagName;
      this.stateRcdataEndTagName(cp);
    } else {
      this.emitChars("</");
      this.state = State.Rcdata;
      this.stateRcdata(cp);
    }
  }

  bool handleSpecialEndTag(int _cp) {
    if (!this.preprocessor.startsWith(this.lastStartTagName, false)) {
      return !this.ensureHibernation();
    }
    this.createEndTagToken();
    this.currentTagToken.tagName = this.lastStartTagName;
    int cp = this.preprocessor.peek(this.lastStartTagName.length);
    if (isWhitespace(cp)) {
      this.advanceBy(this.lastStartTagName.length);
      this.state = State.BeforeAttributeName;
      return false;
    }
    if (cp == SOLIDUS) {
      this.advanceBy(this.lastStartTagName.length);
      this.state = State.SelfClosingStartTag;
      return false;
    }
    if (cp == GREATER_THAN_SIGN) {
      this.advanceBy(this.lastStartTagName.length);
      this.emitCurrentTagToken();
      this.state = State.Data;
      return false;
    }
    return !this.ensureHibernation();
  }

  void stateRcdataEndTagName(int cp) {
    if (this.handleSpecialEndTag(cp)) {
      this.emitChars("</");
      this.state = State.Rcdata;
      this.stateRcdata(cp);
    }
  }

  void stateRawtextLessThanSign(int cp) {
    if (cp == SOLIDUS) {
      this.state = State.RawtextEndTagOpen;
    } else {
      this.emitChars("<");
      this.state = State.Rawtext;
      this.stateRawtext(cp);
    }
  }

  void stateRawtextEndTagOpen(int cp) {
    if (isAsciiLetter(cp)) {
      this.state = State.RawtextEndTagName;
      this.stateRawtextEndTagName(cp);
    } else {
      this.emitChars("</");
      this.state = State.Rawtext;
      this.stateRawtext(cp);
    }
  }

  void stateRawtextEndTagName(int cp) {
    if (this.handleSpecialEndTag(cp)) {
      this.emitChars("</");
      this.state = State.Rawtext;
      this.stateRawtext(cp);
    }
  }

  void stateScriptDataLessThanSign(int cp) {
    if (cp == SOLIDUS) {
      this.state = State.ScriptDataEndTagOpen;
    } else if (cp == EXCLAMATION_MARK) {
      this.state = State.ScriptDataEscapeStart;
      this.emitChars("<!");
    } else {
      this.emitChars("<");
      this.state = State.ScriptData;
      this.stateScriptData(cp);
    }
  }

  void stateScriptDataEndTagOpen(int cp) {
    if (isAsciiLetter(cp)) {
      this.state = State.ScriptDataEndTagName;
      this.stateScriptDataEndTagName(cp);
    } else {
      this.emitChars("</");
      this.state = State.ScriptData;
      this.stateScriptData(cp);
    }
  }

  void stateScriptDataEndTagName(int cp) {
    if (this.handleSpecialEndTag(cp)) {
      this.emitChars("</");
      this.state = State.ScriptData;
      this.stateScriptData(cp);
    }
  }

  void stateScriptDataEscapeStart(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.ScriptDataEscapeStartDash;
      this.emitChars("-");
    } else {
      this.state = State.ScriptData;
      this.stateScriptData(cp);
    }
  }

  void stateScriptDataEscapeStartDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.ScriptDataEscapedDashDash;
      this.emitChars("-");
    } else {
      this.state = State.ScriptData;
      this.stateScriptData(cp);
    }
  }

  void stateScriptDataEscaped(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.ScriptDataEscapedDash;
      this.emitChars("-");
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataEscapedLessThanSign;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInScriptHtmlCommentLikeText, 0);
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateScriptDataEscapedDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.ScriptDataEscapedDashDash;
      this.emitChars("-");
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataEscapedLessThanSign;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.state = State.ScriptDataEscaped;
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInScriptHtmlCommentLikeText, 0);
      this.emitEOFToken();
    } else {
      this.state = State.ScriptDataEscaped;
      this.emitCodePoint(cp);
    }
  }

  void stateScriptDataEscapedDashDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.emitChars("-");
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataEscapedLessThanSign;
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.ScriptData;
      this.emitChars(">");
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.state = State.ScriptDataEscaped;
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInScriptHtmlCommentLikeText, 0);
      this.emitEOFToken();
    } else {
      this.state = State.ScriptDataEscaped;
      this.emitCodePoint(cp);
    }
  }

  void stateScriptDataEscapedLessThanSign(int cp) {
    if (cp == SOLIDUS) {
      this.state = State.ScriptDataEscapedEndTagOpen;
    } else if (isAsciiLetter(cp)) {
      this.emitChars("<");
      this.state = State.ScriptDataDoubleEscapeStart;
      this.stateScriptDataDoubleEscapeStart(cp);
    } else {
      this.emitChars("<");
      this.state = State.ScriptDataEscaped;
      this.stateScriptDataEscaped(cp);
    }
  }

  void stateScriptDataEscapedEndTagOpen(int cp) {
    if (isAsciiLetter(cp)) {
      this.state = State.ScriptDataEscapedEndTagName;
      this.stateScriptDataEscapedEndTagName(cp);
    } else {
      this.emitChars("</");
      this.state = State.ScriptDataEscaped;
      this.stateScriptDataEscaped(cp);
    }
  }

  void stateScriptDataEscapedEndTagName(int cp) {
    if (this.handleSpecialEndTag(cp)) {
      this.emitChars("</");
      this.state = State.ScriptDataEscaped;
      this.stateScriptDataEscaped(cp);
    }
  }

  void stateScriptDataDoubleEscapeStart(int cp) {
    if (this.preprocessor.startsWith(SCRIPT, false) && isScriptDataDoubleEscapeSequenceEnd(this.preprocessor.peek(SCRIPT.length))) {
      this.emitCodePoint(cp);
      int i = 0;
      while (i < SCRIPT.length) {
        this.emitCodePoint(this.consume());
        i = i + 1;
      }
      this.state = State.ScriptDataDoubleEscaped;
    } else if (!this.ensureHibernation()) {
      this.state = State.ScriptDataEscaped;
      this.stateScriptDataEscaped(cp);
    }
  }

  void stateScriptDataDoubleEscaped(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.ScriptDataDoubleEscapedDash;
      this.emitChars("-");
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataDoubleEscapedLessThanSign;
      this.emitChars("<");
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInScriptHtmlCommentLikeText, 0);
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateScriptDataDoubleEscapedDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.ScriptDataDoubleEscapedDashDash;
      this.emitChars("-");
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataDoubleEscapedLessThanSign;
      this.emitChars("<");
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.state = State.ScriptDataDoubleEscaped;
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInScriptHtmlCommentLikeText, 0);
      this.emitEOFToken();
    } else {
      this.state = State.ScriptDataDoubleEscaped;
      this.emitCodePoint(cp);
    }
  }

  void stateScriptDataDoubleEscapedDashDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.emitChars("-");
    } else if (cp == LESS_THAN_SIGN) {
      this.state = State.ScriptDataDoubleEscapedLessThanSign;
      this.emitChars("<");
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.ScriptData;
      this.emitChars(">");
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.state = State.ScriptDataDoubleEscaped;
      this.emitChars(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInScriptHtmlCommentLikeText, 0);
      this.emitEOFToken();
    } else {
      this.state = State.ScriptDataDoubleEscaped;
      this.emitCodePoint(cp);
    }
  }

  void stateScriptDataDoubleEscapedLessThanSign(int cp) {
    if (cp == SOLIDUS) {
      this.state = State.ScriptDataDoubleEscapeEnd;
      this.emitChars("/");
    } else {
      this.state = State.ScriptDataDoubleEscaped;
      this.stateScriptDataDoubleEscaped(cp);
    }
  }

  void stateScriptDataDoubleEscapeEnd(int cp) {
    if (this.preprocessor.startsWith(SCRIPT, false) && isScriptDataDoubleEscapeSequenceEnd(this.preprocessor.peek(SCRIPT.length))) {
      this.emitCodePoint(cp);
      int i = 0;
      while (i < SCRIPT.length) {
        this.emitCodePoint(this.consume());
        i = i + 1;
      }
      this.state = State.ScriptDataEscaped;
    } else if (!this.ensureHibernation()) {
      this.state = State.ScriptDataDoubleEscaped;
      this.stateScriptDataDoubleEscaped(cp);
    }
  }

  void stateBeforeAttributeName(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == SOLIDUS || cp == GREATER_THAN_SIGN || cp == EOF) {
      this.state = State.AfterAttributeName;
      this.stateAfterAttributeName(cp);
    } else if (cp == EQUALS_SIGN) {
      this.err(ErrorCode.UnexpectedEqualsSignBeforeAttributeName, 0);
      this.createAttr("=");
      this.state = State.AttributeName;
    } else {
      this.createAttr("");
      this.state = State.AttributeName;
      this.stateAttributeName(cp);
    }
  }

  void stateAttributeName(int cp) {
    if (isWhitespace(cp) || cp == SOLIDUS || cp == GREATER_THAN_SIGN || cp == EOF) {
      this.leaveAttrName();
      this.state = State.AfterAttributeName;
      this.stateAfterAttributeName(cp);
    } else if (cp == EQUALS_SIGN) {
      this.leaveAttrName();
      this.state = State.BeforeAttributeValue;
    } else if (cp == QUOTATION_MARK || cp == APOSTROPHE || cp == LESS_THAN_SIGN) {
      this.err(ErrorCode.UnexpectedCharacterInAttributeName, 0);
      this.currentAttr.name = this.currentAttr.name + fromCodePoint(cp);
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentAttr.name = this.currentAttr.name + REPLACEMENT_CHARACTER;
    } else {
      int output = cp;
      if (isAsciiUpper(cp)) output = toAsciiLower(cp);
      this.currentAttr.name = this.currentAttr.name + fromCodePoint(output);
    }
  }

  void stateAfterAttributeName(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == SOLIDUS) {
      this.state = State.SelfClosingStartTag;
    } else if (cp == EQUALS_SIGN) {
      this.state = State.BeforeAttributeValue;
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentTagToken();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      this.createAttr("");
      this.state = State.AttributeName;
      this.stateAttributeName(cp);
    }
  }

  void stateBeforeAttributeValue(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == QUOTATION_MARK) {
      this.state = State.AttributeValueDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.state = State.AttributeValueSingleQuoted;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingAttributeValue, 0);
      this.state = State.Data;
      this.emitCurrentTagToken();
    } else {
      this.state = State.AttributeValueUnquoted;
      this.stateAttributeValueUnquoted(cp);
    }
  }

  void stateAttributeValueDoubleQuoted(int cp) {
    if (cp == QUOTATION_MARK) {
      this.state = State.AfterAttributeValueQuoted;
    } else if (cp == AMPERSAND) {
      this.startCharacterReference();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentAttr.value = this.currentAttr.value + REPLACEMENT_CHARACTER;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      this.currentAttr.value = this.currentAttr.value + fromCodePoint(cp);
    }
  }

  void stateAttributeValueSingleQuoted(int cp) {
    if (cp == APOSTROPHE) {
      this.state = State.AfterAttributeValueQuoted;
    } else if (cp == AMPERSAND) {
      this.startCharacterReference();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentAttr.value = this.currentAttr.value + REPLACEMENT_CHARACTER;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      this.currentAttr.value = this.currentAttr.value + fromCodePoint(cp);
    }
  }

  void stateAttributeValueUnquoted(int cp) {
    if (isWhitespace(cp)) {
      this.leaveAttrValue();
      this.state = State.BeforeAttributeName;
    } else if (cp == AMPERSAND) {
      this.startCharacterReference();
    } else if (cp == GREATER_THAN_SIGN) {
      this.leaveAttrValue();
      this.state = State.Data;
      this.emitCurrentTagToken();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentAttr.value = this.currentAttr.value + REPLACEMENT_CHARACTER;
    } else if (cp == QUOTATION_MARK || cp == APOSTROPHE || cp == LESS_THAN_SIGN || cp == EQUALS_SIGN || cp == GRAVE_ACCENT) {
      this.err(ErrorCode.UnexpectedCharacterInUnquotedAttributeValue, 0);
      this.currentAttr.value = this.currentAttr.value + fromCodePoint(cp);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      this.currentAttr.value = this.currentAttr.value + fromCodePoint(cp);
    }
  }

  void stateAfterAttributeValueQuoted(int cp) {
    if (isWhitespace(cp)) {
      this.leaveAttrValue();
      this.state = State.BeforeAttributeName;
    } else if (cp == SOLIDUS) {
      this.leaveAttrValue();
      this.state = State.SelfClosingStartTag;
    } else if (cp == GREATER_THAN_SIGN) {
      this.leaveAttrValue();
      this.state = State.Data;
      this.emitCurrentTagToken();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingWhitespaceBetweenAttributes, 0);
      this.state = State.BeforeAttributeName;
      this.stateBeforeAttributeName(cp);
    }
  }

  void stateSelfClosingStartTag(int cp) {
    if (cp == GREATER_THAN_SIGN) {
      this.currentTagToken.selfClosing = true;
      this.state = State.Data;
      this.emitCurrentTagToken();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInTag, 0);
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.UnexpectedSolidusInTag, 0);
      this.state = State.BeforeAttributeName;
      this.stateBeforeAttributeName(cp);
    }
  }

  void stateBogusComment(int cp) {
    if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentComment();
    } else if (cp == EOF) {
      this.emitCurrentComment();
      this.emitEOFToken();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentCommentToken.data = this.currentCommentToken.data + REPLACEMENT_CHARACTER;
    } else {
      this.currentCommentToken.data = this.currentCommentToken.data + fromCodePoint(cp);
    }
  }

  void stateMarkupDeclarationOpen(int cp) {
    if (this.consumeSequenceIfMatch(DASH_DASH, true)) {
      this.createCommentToken(DASH_DASH.length + 1);
      this.state = State.CommentStart;
    } else if (this.consumeSequenceIfMatch(DOCTYPE, false)) {
      this.currentLocation = this.getCurrentLocation(DOCTYPE.length + 1);
      this.state = State.Doctype;
    } else if (this.consumeSequenceIfMatch(CDATA_START, true)) {
      if (this.inForeignNode) {
        this.state = State.CdataSection;
      } else {
        this.err(ErrorCode.CdataInHtmlContent, 0);
        this.createCommentToken(CDATA_START.length + 1);
        this.currentCommentToken.data = "[CDATA[";
        this.state = State.BogusComment;
      }
    } else if (!this.ensureHibernation()) {
      this.err(ErrorCode.IncorrectlyOpenedComment, 0);
      this.createCommentToken(2);
      this.state = State.BogusComment;
      this.stateBogusComment(cp);
    }
  }

  void stateCommentStart(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.CommentStartDash;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.AbruptClosingOfEmptyComment, 0);
      this.state = State.Data;
      this.emitCurrentComment();
    } else {
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void stateCommentStartDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.CommentEnd;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.AbruptClosingOfEmptyComment, 0);
      this.state = State.Data;
      this.emitCurrentComment();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInComment, 0);
      this.emitCurrentComment();
      this.emitEOFToken();
    } else {
      this.currentCommentToken.data = this.currentCommentToken.data + "-";
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void stateComment(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.CommentEndDash;
    } else if (cp == LESS_THAN_SIGN) {
      this.currentCommentToken.data = this.currentCommentToken.data + "<";
      this.state = State.CommentLessThanSign;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.currentCommentToken.data = this.currentCommentToken.data + REPLACEMENT_CHARACTER;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInComment, 0);
      this.emitCurrentComment();
      this.emitEOFToken();
    } else {
      this.currentCommentToken.data = this.currentCommentToken.data + fromCodePoint(cp);
    }
  }

  void stateCommentLessThanSign(int cp) {
    if (cp == EXCLAMATION_MARK) {
      this.currentCommentToken.data = this.currentCommentToken.data + "!";
      this.state = State.CommentLessThanSignBang;
    } else if (cp == LESS_THAN_SIGN) {
      this.currentCommentToken.data = this.currentCommentToken.data + "<";
    } else {
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void stateCommentLessThanSignBang(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.CommentLessThanSignBangDash;
    } else {
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void stateCommentLessThanSignBangDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.CommentLessThanSignBangDashDash;
    } else {
      this.state = State.CommentEndDash;
      this.stateCommentEndDash(cp);
    }
  }

  void stateCommentLessThanSignBangDashDash(int cp) {
    if (cp != GREATER_THAN_SIGN && cp != EOF) this.err(ErrorCode.NestedComment, 0);
    this.state = State.CommentEnd;
    this.stateCommentEnd(cp);
  }

  void stateCommentEndDash(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.state = State.CommentEnd;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInComment, 0);
      this.emitCurrentComment();
      this.emitEOFToken();
    } else {
      this.currentCommentToken.data = this.currentCommentToken.data + "-";
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void stateCommentEnd(int cp) {
    if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentComment();
    } else if (cp == EXCLAMATION_MARK) {
      this.state = State.CommentEndBang;
    } else if (cp == HYPHEN_MINUS) {
      this.currentCommentToken.data = this.currentCommentToken.data + "-";
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInComment, 0);
      this.emitCurrentComment();
      this.emitEOFToken();
    } else {
      this.currentCommentToken.data = this.currentCommentToken.data + "--";
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void stateCommentEndBang(int cp) {
    if (cp == HYPHEN_MINUS) {
      this.currentCommentToken.data = this.currentCommentToken.data + "--!";
      this.state = State.CommentEndDash;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.IncorrectlyClosedComment, 0);
      this.state = State.Data;
      this.emitCurrentComment();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInComment, 0);
      this.emitCurrentComment();
      this.emitEOFToken();
    } else {
      this.currentCommentToken.data = this.currentCommentToken.data + "--!";
      this.state = State.Comment;
      this.stateComment(cp);
    }
  }

  void appendDoctypeName(string value) {
    string? current = this.currentDoctypeToken.name;
    if (current == null) {
      this.currentDoctypeToken.name = value;
    } else {
      this.currentDoctypeToken.name = current + value;
    }
  }

  void appendDoctypePublicId(string value) {
    string? current = this.currentDoctypeToken.publicId;
    if (current == null) {
      this.currentDoctypeToken.publicId = value;
    } else {
      this.currentDoctypeToken.publicId = current + value;
    }
  }

  void appendDoctypeSystemId(string value) {
    string? current = this.currentDoctypeToken.systemId;
    if (current == null) {
      this.currentDoctypeToken.systemId = value;
    } else {
      this.currentDoctypeToken.systemId = current + value;
    }
  }

  void stateDoctype(int cp) {
    if (isWhitespace(cp)) {
      this.state = State.BeforeDoctypeName;
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.BeforeDoctypeName;
      this.stateBeforeDoctypeName(cp);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.createDoctypeToken(null);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingWhitespaceBeforeDoctypeName, 0);
      this.state = State.BeforeDoctypeName;
      this.stateBeforeDoctypeName(cp);
    }
  }

  void stateBeforeDoctypeName(int cp) {
    if (isAsciiUpper(cp)) {
      this.createDoctypeToken(fromCodePoint(toAsciiLower(cp)));
      this.state = State.DoctypeName;
      return;
    }
    if (isWhitespace(cp)) return;
    if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.createDoctypeToken(REPLACEMENT_CHARACTER);
      this.state = State.DoctypeName;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingDoctypeName, 0);
      this.createDoctypeToken(null);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.createDoctypeToken(null);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.createDoctypeToken(fromCodePoint(cp));
      this.state = State.DoctypeName;
    }
  }

  void stateDoctypeName(int cp) {
    if (isWhitespace(cp)) {
      this.state = State.AfterDoctypeName;
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.appendDoctypeName(REPLACEMENT_CHARACTER);
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      int output = cp;
      if (isAsciiUpper(cp)) output = toAsciiLower(cp);
      this.appendDoctypeName(fromCodePoint(output));
    }
  }

  void stateAfterDoctypeName(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else if (this.consumeSequenceIfMatch(PUBLIC, false)) {
      this.state = State.AfterDoctypePublicKeyword;
    } else if (this.consumeSequenceIfMatch(SYSTEM, false)) {
      this.state = State.AfterDoctypeSystemKeyword;
    } else if (!this.ensureHibernation()) {
      this.err(ErrorCode.InvalidCharacterSequenceAfterDoctypeName, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateAfterDoctypePublicKeyword(int cp) {
    if (isWhitespace(cp)) {
      this.state = State.BeforeDoctypePublicIdentifier;
    } else if (cp == QUOTATION_MARK) {
      this.err(ErrorCode.MissingWhitespaceAfterDoctypePublicKeyword, 0);
      this.currentDoctypeToken.publicId = "";
      this.state = State.DoctypePublicIdentifierDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.err(ErrorCode.MissingWhitespaceAfterDoctypePublicKeyword, 0);
      this.currentDoctypeToken.publicId = "";
      this.state = State.DoctypePublicIdentifierSingleQuoted;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingDoctypePublicIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingQuoteBeforeDoctypePublicIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateBeforeDoctypePublicIdentifier(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == QUOTATION_MARK) {
      this.currentDoctypeToken.publicId = "";
      this.state = State.DoctypePublicIdentifierDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.currentDoctypeToken.publicId = "";
      this.state = State.DoctypePublicIdentifierSingleQuoted;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingDoctypePublicIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingQuoteBeforeDoctypePublicIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateDoctypePublicIdentifierDoubleQuoted(int cp) {
    if (cp == QUOTATION_MARK) {
      this.state = State.AfterDoctypePublicIdentifier;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.appendDoctypePublicId(REPLACEMENT_CHARACTER);
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.AbruptDoctypePublicIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.appendDoctypePublicId(fromCodePoint(cp));
    }
  }

  void stateDoctypePublicIdentifierSingleQuoted(int cp) {
    if (cp == APOSTROPHE) {
      this.state = State.AfterDoctypePublicIdentifier;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.appendDoctypePublicId(REPLACEMENT_CHARACTER);
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.AbruptDoctypePublicIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.appendDoctypePublicId(fromCodePoint(cp));
    }
  }

  void stateAfterDoctypePublicIdentifier(int cp) {
    if (isWhitespace(cp)) {
      this.state = State.BetweenDoctypePublicAndSystemIdentifiers;
    } else if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == QUOTATION_MARK) {
      this.err(ErrorCode.MissingWhitespaceBetweenDoctypePublicAndSystemIdentifiers, 0);
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.err(ErrorCode.MissingWhitespaceBetweenDoctypePublicAndSystemIdentifiers, 0);
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierSingleQuoted;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingQuoteBeforeDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateBetweenDoctypePublicAndSystemIdentifiers(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == GREATER_THAN_SIGN) {
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == QUOTATION_MARK) {
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierSingleQuoted;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingQuoteBeforeDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateAfterDoctypeSystemKeyword(int cp) {
    if (isWhitespace(cp)) {
      this.state = State.BeforeDoctypeSystemIdentifier;
    } else if (cp == QUOTATION_MARK) {
      this.err(ErrorCode.MissingWhitespaceAfterDoctypeSystemKeyword, 0);
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.err(ErrorCode.MissingWhitespaceAfterDoctypeSystemKeyword, 0);
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierSingleQuoted;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingQuoteBeforeDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateBeforeDoctypeSystemIdentifier(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == QUOTATION_MARK) {
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierDoubleQuoted;
    } else if (cp == APOSTROPHE) {
      this.currentDoctypeToken.systemId = "";
      this.state = State.DoctypeSystemIdentifierSingleQuoted;
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.MissingDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.Data;
      this.emitCurrentDoctype();
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.MissingQuoteBeforeDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateDoctypeSystemIdentifierDoubleQuoted(int cp) {
    if (cp == QUOTATION_MARK) {
      this.state = State.AfterDoctypeSystemIdentifier;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.appendDoctypeSystemId(REPLACEMENT_CHARACTER);
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.AbruptDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.appendDoctypeSystemId(fromCodePoint(cp));
    }
  }

  void stateDoctypeSystemIdentifierSingleQuoted(int cp) {
    if (cp == APOSTROPHE) {
      this.state = State.AfterDoctypeSystemIdentifier;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
      this.appendDoctypeSystemId(REPLACEMENT_CHARACTER);
    } else if (cp == GREATER_THAN_SIGN) {
      this.err(ErrorCode.AbruptDoctypeSystemIdentifier, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.appendDoctypeSystemId(fromCodePoint(cp));
    }
  }

  void stateAfterDoctypeSystemIdentifier(int cp) {
    if (isWhitespace(cp)) return;
    if (cp == GREATER_THAN_SIGN) {
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInDoctype, 0);
      this.currentDoctypeToken.forceQuirks = true;
      this.emitCurrentDoctype();
      this.emitEOFToken();
    } else {
      this.err(ErrorCode.UnexpectedCharacterAfterDoctypeSystemIdentifier, 0);
      this.state = State.BogusDoctype;
      this.stateBogusDoctype(cp);
    }
  }

  void stateBogusDoctype(int cp) {
    if (cp == GREATER_THAN_SIGN) {
      this.emitCurrentDoctype();
      this.state = State.Data;
    } else if (cp == NULL) {
      this.err(ErrorCode.UnexpectedNullCharacter, 0);
    } else if (cp == EOF) {
      this.emitCurrentDoctype();
      this.emitEOFToken();
    }
  }

  void stateCdataSection(int cp) {
    if (cp == RIGHT_SQUARE_BRACKET) {
      this.state = State.CdataSectionBracket;
    } else if (cp == EOF) {
      this.err(ErrorCode.EofInCdata, 0);
      this.emitEOFToken();
    } else {
      this.emitCodePoint(cp);
    }
  }

  void stateCdataSectionBracket(int cp) {
    if (cp == RIGHT_SQUARE_BRACKET) {
      this.state = State.CdataSectionEnd;
    } else {
      this.emitChars("]");
      this.state = State.CdataSection;
      this.stateCdataSection(cp);
    }
  }

  void stateCdataSectionEnd(int cp) {
    if (cp == GREATER_THAN_SIGN) {
      this.state = State.Data;
    } else if (cp == RIGHT_SQUARE_BRACKET) {
      this.emitChars("]");
    } else {
      this.emitChars("]]");
      this.state = State.CdataSection;
      this.stateCdataSection(cp);
    }
  }

  void stateCharacterReference() {
    int length = this.entityDecoder.write(this.preprocessor.html, this.preprocessor.pos);
    if (length < 0) {
      if (this.preprocessor.lastChunkWritten) {
        length = this.entityDecoder.end();
      } else {
        this.active = false;
        this.preprocessor.pos = this.preprocessor.html.length - 1;
        this.consumedAfterSnapshot = 0;
        this.preprocessor.endOfChunkHit = true;
        return;
      }
    }
    if (length == 0) {
      this.preprocessor.pos = this.entityStartPos;
      this.flushCodePointConsumedAsCharacterReference(AMPERSAND);
      if (!this.isCharacterReferenceInAttribute() && isAsciiAlphaNumeric(this.preprocessor.peek(1))) {
        this.state = State.AmbiguousAmpersand;
      } else {
        this.state = this.returnState;
      }
    } else {
      this.state = this.returnState;
    }
  }

  void stateAmbiguousAmpersand(int cp) {
    if (isAsciiAlphaNumeric(cp)) {
      this.flushCodePointConsumedAsCharacterReference(cp);
    } else {
      if (cp == SEMICOLON) this.err(ErrorCode.UnknownNamedCharacterReference, 0);
      this.state = this.returnState;
      this.callState(cp);
    }
  }
}
