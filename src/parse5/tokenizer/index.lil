  }

  void stateAfterDoctypeSystemIdentifier(int cp) {
    if (isWs(cp)) {
      return;
    }
    if (cp == CP_GT) {
      this.emitCurrentDoctype(this.currentToken);
      this.state = ST_DATA;
    } else if (cp == CP_EOF) {
      this.err(ERR_eofInDoctype, 0);
      JS.set(this.currentToken, "forceQuirks", true);
      this.emitCurrentDoctype(this.currentToken);
      this.emitEOFToken();
    } else {
      this.err(ERR_unexpectedCharacterAfterDoctypeSystemIdentifier, 0);
      this.state = ST_BOGUS_DOCTYPE;
