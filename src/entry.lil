import { unified } from "./unified/entry.lil";
import { rehypeParse as parsePlugin } from "./parse.lil";
import { rehypeStringify as stringifyPlugin } from "./stringify.lil";

JsValue buildRehype() {
  JsValue proc = JS.call(unified, JS.undefined());
  proc = JS.call(JS.get(proc, "use"), proc, parsePlugin);
  proc = JS.call(JS.get(proc, "use"), proc, stringifyPlugin);
  proc = JS.call(JS.get(proc, "freeze"), proc);
  return proc;
}

JsValue rehypeValue = buildRehype();

export JsValue rehype = rehypeValue;
export JsValue default = rehypeValue;
export JsValue rehypeParse = parsePlugin;
export JsValue rehypeStringify = stringifyPlugin;
