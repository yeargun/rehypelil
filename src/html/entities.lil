import { charInSet, fromCharCode } from "./types.lil";

string hexUpper(int code) {
  if (code <= 0) {
    return "0";
  }
  string digits = "0123456789ABCDEF";
  string out = "";
  int n = code;
  while (n > 0) {
    int d = n % 16;
    out = digits.charAt(d) + out;
    n = n / 16;
  }
  return out;
}

export string stringifyEntities(string value, string subset) {
  string out = "";
  int n = value.length;
  int i = 0;
  while (i < n) {
    string ch = value.charAt(i);
    if (charInSet(ch, subset)) {
      out = out + "&#x" + hexUpper(ch.charCodeAt(0)) + ";";
    } else {
      out = out + ch;
    }
    i = i + 1;
  }
  return out;
}

export string textSubset() {
  return "<&";
}

export string commentSubset() {
  return "<>";
}

export string bogusSubset() {
  return ">";
}

export string nameSubset(bool parseErrors, bool dangerous) {
  string nul = fromCharCode(0);
  string ws = fromCharCode(9) + fromCharCode(10) + fromCharCode(12) + fromCharCode(13) + " ";
  if (parseErrors) {
    if (dangerous) {
      return ws + "&/=>";
    }
    return ws + "\"&'/=>`";
  }
  if (dangerous) {
    return nul + ws + "\"&'/<=>";
  }
  return nul + ws + "\"&'/<=>`";
}

export string unquotedSubset(bool parseErrors, bool dangerous) {
  string nul = fromCharCode(0);
  string ws = fromCharCode(9) + fromCharCode(10) + fromCharCode(12) + fromCharCode(13) + " ";
  if (parseErrors && dangerous) {
    return ws + "&>";
  }
  return nul + ws + "\"&'<=>`";
}

export string singleSubset(bool parseErrors, bool dangerous) {
  string nul = fromCharCode(0);
  if (parseErrors) {
    if (dangerous) {
      return "&'";
    }
    return "\"&'`";
  }
  if (dangerous) {
    return nul + "&'";
  }
  return nul + "\"&'`";
}

export string doubleSubset(bool parseErrors, bool dangerous) {
  string nul = fromCharCode(0);
  if (parseErrors) {
    if (dangerous) {
      return "\"&";
    }
    return "\"&'`";
  }
  if (dangerous) {
    return nul + "\"&";
  }
  return nul + "\"&'`";
}

export string encodeCommentValue(string value) {
  string out = "";
  int n = value.length;
  int i = 0;
  while (i < n) {
    string rest = value.slice(i);
    if (i == 0 && rest.length > 0 && rest.charAt(0) == ">") {
      out = out + stringifyEntities(">", commentSubset());
      i = i + 1;
    } else if (i == 0 && rest.length >= 2 && rest.slice(0, 2) == "->") {
      out = out + stringifyEntities("->", commentSubset());
      i = i + 2;
    } else if (rest.length >= 4 && rest.slice(0, 4) == "<!--") {
      out = out + stringifyEntities("<!--", commentSubset());
      i = i + 4;
    } else if (rest.length >= 4 && rest.slice(0, 4) == "--!>") {
      out = out + stringifyEntities("--!>", commentSubset());
      i = i + 4;
    } else if (rest.length >= 3 && rest.slice(0, 3) == "-->") {
      out = out + stringifyEntities("-->", commentSubset());
      i = i + 3;
    } else if (rest == "<!-") {
      out = out + stringifyEntities("<!-", commentSubset());
      i = n;
    } else {
      out = out + rest.charAt(0);
      i = i + 1;
    }
  }
  return out;
}
