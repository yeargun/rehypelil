import { Error, Object } from "./unified/host.lil";

string indexOf(JsValue value) {
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return "1";
  }
  if (JS.typeOf(value) != "number") {
    return "1";
  }
  if (!value.truthy()) {
    return "1";
  }
  return JS.string(value);
}

string pointName(JsValue point) {
  if (JS.isUndefined(point) || JS.isNullish(point) || JS.typeOf(point) != "object") {
    return "1:1";
  }
  return indexOf(JS.get(point, "line")) + ":" + indexOf(JS.get(point, "column"));
}

export string stringifyPosition(JsValue value) {
  if (JS.isUndefined(value) || JS.isNullish(value) || JS.typeOf(value) != "object") {
    return "";
  }
  if (JS.in("position", value) || JS.in("type", value)) {
    return stringifyPosition(JS.get(value, "position"));
  }
  if (JS.in("start", value) || JS.in("end", value)) {
    return pointName(JS.get(value, "start")) + "-" + pointName(JS.get(value, "end"));
  }
  if (JS.in("line", value) || JS.in("column", value)) {
    return pointName(value);
  }
  return "";
}

export JsValue createMessage(string reason, JsValue place, string ruleId, string source) {
  JsValue msg = JS.construct(Error, reason);
  JsValue start = place;
  if (!(JS.isUndefined(place) || JS.isNullish(place)) && JS.in("start", place)) {
    start = JS.get(place, "start");
  }
  string name = stringifyPosition(place);
  if (name.length == 0) {
    name = "1:1";
  }
  JS.invoke(Object, "defineProperty", msg, "stack", JS.object("enumerable", false, "configurable", true, "writable", true, "value", ""));
  JS.invoke(Object, "defineProperty", msg, "message", JS.object("enumerable", true, "configurable", true, "writable", true, "value", reason));
  JS.set(msg, "name", name);
  JS.set(msg, "reason", reason);
  JS.set(msg, "ruleId", ruleId);
  JS.set(msg, "source", source);
  JS.set(msg, "place", place);
  JS.set(msg, "file", "");
  if (!(JS.isUndefined(start) || JS.isNullish(start))) {
    JS.set(msg, "line", JS.get(start, "line"));
    JS.set(msg, "column", JS.get(start, "column"));
  }
  return msg;
}
