export struct ParseErrorInfo {
  string reason;
  string description;
  bool url;
}

export ParseErrorInfo? parseErrorInfo(string name) {
  if (name == "abandonedHeadElementChild") return ParseErrorInfo{"Unexpected metadata element after head", "Unexpected element after head. Expected the element before `</head>`", false};
  if (name == "abruptClosingOfEmptyComment") return ParseErrorInfo{"Unexpected abruptly closed empty comment", "Unexpected `>` or `->`. Expected `-->` to close comments", true};
  if (name == "abruptDoctypePublicIdentifier") return ParseErrorInfo{"Unexpected abruptly closed public identifier", "Unexpected `>`. Expected a closing `\"` or `'` after the public identifier", true};
  if (name == "abruptDoctypeSystemIdentifier") return ParseErrorInfo{"Unexpected abruptly closed system identifier", "Unexpected `>`. Expected a closing `\"` or `'` after the identifier identifier", true};
  if (name == "absenceOfDigitsInNumericCharacterReference") return ParseErrorInfo{"Unexpected non-digit at start of numeric character reference", "Unexpected `%c`. Expected `[0-9]` for decimal references or `[0-9a-fA-F]` for hexadecimal references", true};
  if (name == "cdataInHtmlContent") return ParseErrorInfo{"Unexpected CDATA section in HTML", "Unexpected `<![CDATA[` in HTML. Remove it, use a comment, or encode special characters instead", true};
  if (name == "characterReferenceOutsideUnicodeRange") return ParseErrorInfo{"Unexpected too big numeric character reference", "Unexpectedly high character reference. Expected character references to be at most hexadecimal 10ffff (or decimal 1114111)", true};
  if (name == "closingOfElementWithOpenChildElements") return ParseErrorInfo{"Unexpected closing tag with open child elements", "Unexpectedly closing tag. Expected other tags to be closed first", false};
  if (name == "controlCharacterInInputStream") return ParseErrorInfo{"Unexpected control character", "Unexpected control character `%x`. Expected a non-control code point, 0x00, or ASCII whitespace", true};
  if (name == "controlCharacterReference") return ParseErrorInfo{"Unexpected control character reference", "Unexpectedly control character in reference. Expected a non-control code point, 0x00, or ASCII whitespace", true};
  if (name == "disallowedContentInNoscriptInHead") return ParseErrorInfo{"Disallowed content inside `<noscript>` in `<head>`", "Unexpected text character `%c`. Only use text in `<noscript>`s in `<body>`", false};
  if (name == "duplicateAttribute") return ParseErrorInfo{"Unexpected duplicate attribute", "Unexpectedly double attribute. Expected attributes to occur only once", true};
  if (name == "endTagWithAttributes") return ParseErrorInfo{"Unexpected attribute on closing tag", "Unexpected attribute. Expected `>` instead", true};
  if (name == "endTagWithTrailingSolidus") return ParseErrorInfo{"Unexpected slash at end of closing tag", "Unexpected `%c-1`. Expected `>` instead", true};
  if (name == "endTagWithoutMatchingOpenElement") return ParseErrorInfo{"Unexpected unopened end tag", "Unexpected end tag. Expected no end tag or another end tag", false};
  if (name == "eofBeforeTagName") return ParseErrorInfo{"Unexpected end of file", "Unexpected end of file. Expected tag name instead", true};
  if (name == "eofInCdata") return ParseErrorInfo{"Unexpected end of file in CDATA", "Unexpected end of file. Expected `]]>` to close the CDATA", true};
  if (name == "eofInComment") return ParseErrorInfo{"Unexpected end of file in comment", "Unexpected end of file. Expected `-->` to close the comment", true};
  if (name == "eofInDoctype") return ParseErrorInfo{"Unexpected end of file in doctype", "Unexpected end of file. Expected a valid doctype (such as `<!doctype html>`)", true};
  if (name == "eofInElementThatCanContainOnlyText") return ParseErrorInfo{"Unexpected end of file in element that can only contain text", "Unexpected end of file. Expected text or a closing tag", false};
  if (name == "eofInScriptHtmlCommentLikeText") return ParseErrorInfo{"Unexpected end of file in comment inside script", "Unexpected end of file. Expected `-->` to close the comment", true};
  if (name == "eofInTag") return ParseErrorInfo{"Unexpected end of file in tag", "Unexpected end of file. Expected `>` to close the tag", true};
  if (name == "incorrectlyClosedComment") return ParseErrorInfo{"Incorrectly closed comment", "Unexpected `%c-1`. Expected `-->` to close the comment", true};
  if (name == "incorrectlyOpenedComment") return ParseErrorInfo{"Incorrectly opened comment", "Unexpected `%c`. Expected `<!--` to open the comment", true};
  if (name == "invalidCharacterSequenceAfterDoctypeName") return ParseErrorInfo{"Invalid sequence after doctype name", "Unexpected sequence at `%c`. Expected `public` or `system`", true};
  if (name == "invalidFirstCharacterOfTagName") return ParseErrorInfo{"Invalid first character in tag name", "Unexpected `%c`. Expected an ASCII letter instead", true};
  if (name == "misplacedDoctype") return ParseErrorInfo{"Misplaced doctype", "Unexpected doctype. Expected doctype before head", false};
  if (name == "misplacedStartTagForHeadElement") return ParseErrorInfo{"Misplaced `<head>` start tag", "Unexpected start tag `<head>`. Expected `<head>` directly after doctype", false};
  if (name == "missingAttributeValue") return ParseErrorInfo{"Missing attribute value", "Unexpected `%c-1`. Expected an attribute value or no `%c-1` instead", true};
  if (name == "missingDoctype") return ParseErrorInfo{"Missing doctype before other content", "Expected a `<!doctype html>` before anything else", false};
  if (name == "missingDoctypeName") return ParseErrorInfo{"Missing doctype name", "Unexpected doctype end at `%c`. Expected `html` instead", true};
  if (name == "missingDoctypePublicIdentifier") return ParseErrorInfo{"Missing public identifier in doctype", "Unexpected `%c`. Expected identifier for `public` instead", true};
  if (name == "missingDoctypeSystemIdentifier") return ParseErrorInfo{"Missing system identifier in doctype", "Unexpected `%c`. Expected identifier for `system` instead (suggested: `\"about:legacy-compat\"`)", true};
  if (name == "missingEndTagName") return ParseErrorInfo{"Missing name in end tag", "Unexpected `%c`. Expected an ASCII letter instead", true};
  if (name == "missingQuoteBeforeDoctypePublicIdentifier") return ParseErrorInfo{"Missing quote before public identifier in doctype", "Unexpected `%c`. Expected `\"` or `'` instead", true};
  if (name == "missingQuoteBeforeDoctypeSystemIdentifier") return ParseErrorInfo{"Missing quote before system identifier in doctype", "Unexpected `%c`. Expected `\"` or `'` instead", true};
  if (name == "missingSemicolonAfterCharacterReference") return ParseErrorInfo{"Missing semicolon after character reference", "Unexpected `%c`. Expected `;` instead", true};
  if (name == "missingWhitespaceAfterDoctypePublicKeyword") return ParseErrorInfo{"Missing whitespace after public identifier in doctype", "Unexpected `%c`. Expected ASCII whitespace instead", true};
  if (name == "missingWhitespaceAfterDoctypeSystemKeyword") return ParseErrorInfo{"Missing whitespace after system identifier in doctype", "Unexpected `%c`. Expected ASCII whitespace instead", true};
  if (name == "missingWhitespaceBeforeDoctypeName") return ParseErrorInfo{"Missing whitespace before doctype name", "Unexpected `%c`. Expected ASCII whitespace instead", true};
  if (name == "missingWhitespaceBetweenAttributes") return ParseErrorInfo{"Missing whitespace between attributes", "Unexpected `%c`. Expected ASCII whitespace instead", true};
  if (name == "missingWhitespaceBetweenDoctypePublicAndSystemIdentifiers") return ParseErrorInfo{"Missing whitespace between public and system identifiers in doctype", "Unexpected `%c`. Expected ASCII whitespace instead", true};
  if (name == "nestedComment") return ParseErrorInfo{"Unexpected nested comment", "Unexpected `<!--`. Expected `-->`", true};
  if (name == "nestedNoscriptInHead") return ParseErrorInfo{"Unexpected nested `<noscript>` in `<head>`", "Unexpected `<noscript>`. Expected a closing tag or a meta element", false};
  if (name == "nonConformingDoctype") return ParseErrorInfo{"Unexpected non-conforming doctype declaration", "Expected `<!doctype html>` or `<!doctype html system \"about:legacy-compat\">`", false};
  if (name == "nonVoidHtmlElementStartTagWithTrailingSolidus") return ParseErrorInfo{"Unexpected trailing slash on start tag of non-void element", "Unexpected `/`. Expected `>` instead", true};
  if (name == "noncharacterCharacterReference") return ParseErrorInfo{"Unexpected noncharacter code point referenced by character reference", "Unexpected code point. Do not use noncharacters in HTML", true};
  if (name == "noncharacterInInputStream") return ParseErrorInfo{"Unexpected noncharacter character", "Unexpected code point `%x`. Do not use noncharacters in HTML", true};
  if (name == "nullCharacterReference") return ParseErrorInfo{"Unexpected NULL character referenced by character reference", "Unexpected code point. Do not use NULL characters in HTML", true};
  if (name == "openElementsLeftAfterEof") return ParseErrorInfo{"Unexpected end of file", "Unexpected end of file. Expected closing tag instead", false};
  if (name == "surrogateCharacterReference") return ParseErrorInfo{"Unexpected surrogate character referenced by character reference", "Unexpected code point. Do not use lone surrogate characters in HTML", true};
  if (name == "surrogateInInputStream") return ParseErrorInfo{"Unexpected surrogate character", "Unexpected code point `%x`. Do not use lone surrogate characters in HTML", true};
  if (name == "unexpectedCharacterAfterDoctypeSystemIdentifier") return ParseErrorInfo{"Invalid character after system identifier in doctype", "Unexpected character at `%c`. Expected `>`", true};
  if (name == "unexpectedCharacterInAttributeName") return ParseErrorInfo{"Unexpected character in attribute name", "Unexpected `%c`. Expected whitespace, `/`, `>`, `=`, or probably an ASCII letter", true};
  if (name == "unexpectedCharacterInUnquotedAttributeValue") return ParseErrorInfo{"Unexpected character in unquoted attribute value", "Unexpected `%c`. Quote the attribute value to include it", true};
  if (name == "unexpectedEqualsSignBeforeAttributeName") return ParseErrorInfo{"Unexpected equals sign before attribute name", "Unexpected `%c`. Add an attribute name before it", true};
  if (name == "unexpectedNullCharacter") return ParseErrorInfo{"Unexpected NULL character", "Unexpected code point `%x`. Do not use NULL characters in HTML", true};
  if (name == "unexpectedQuestionMarkInsteadOfTagName") return ParseErrorInfo{"Unexpected question mark instead of tag name", "Unexpected `%c`. Expected an ASCII letter instead", true};
  if (name == "unexpectedSolidusInTag") return ParseErrorInfo{"Unexpected slash in tag", "Unexpected `%c-1`. Expected it followed by `>` or in a quoted attribute value", true};
  if (name == "unknownNamedCharacterReference") return ParseErrorInfo{"Unexpected unknown named character reference", "Unexpected character reference. Expected known named character references", true};
  return null;
}
