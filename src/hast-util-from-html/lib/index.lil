import { JSON } from "../../unified/host.lil";
import { fromParse5 } from "../../hast-util-from-parse5/lib/index.lil";
import { parseDocument, parseFragment } from "../../parse5/parser/index.lil";
import { ParseErrorInfo, parseErrorInfo } from "./errors.lil";
import { createMessage } from "../../vfile-message/lib/index.lil";

string ERROR_BASE = "https://html.spec.whatwg.org/multipage/parsing.html#parse-error-";

string asDoc(JsValue value) {
  if (value is string) {
    return value;
  }
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return "";
  }
  JsValue toStringFn = JS.get(value, "toString");
  if (JS.typeOf(toStringFn) == "function") {
    JsValue text = JS.call(toStringFn, value);
    if (text is string) {
      return text;
    }
    return JS.string(text);
  }
  if (JS.typeOf(value) == "object") {
    JsValue inner = JS.get(value, "value");
    if (inner is string) {
      return inner;
    }
  }
  return JS.string(value);
}

string camelcase(string value) {
  string out = "";
  int i = 0;
  int n = value.length;
  while (i < n) {
    if (i + 1 < n && value.charAt(i) == "-") {
      out = out + value.charAt(i + 1).toUpperCase();
      i = i + 2;
    } else {
      out = out + value.charAt(i);
      i = i + 1;
    }
  }
  return out;
}

string visualizeCharacter(string char) {
  if (char == "`") {
    return "` ` `";
  }
  return char;
}

string hexUpper(int code) {
  if (code <= 0) {
    return "0";
  }
  string digits = "0123456789ABCDEF";
  string out = "";
  int n = code;
  while (n > 0) {
    int d = n % 16;
    out = digits.charAt(d) + out;
    n = n / 16;
  }
  return out;
}

string visualizeCharacterCode(int charCode) {
  return "0x" + hexUpper(charCode);
}

string formatTemplate(string value, string document, JsValue error) {
  string out = "";
  int i = 0;
  int n = value.length;
  int startOffset = 0;
  JsValue off = JS.get(error, "startOffset");
  if (!(JS.isUndefined(off) || JS.isNullish(off))) {
    startOffset = JS.number(off).toInt();
  }
  while (i < n) {
    if (i + 1 < n && value.charAt(i) == "%" && value.charAt(i + 1) == "x") {
      int code = 0;
      if (startOffset >= 0 && startOffset < document.length) {
        code = document.charCodeAt(startOffset);
      }
      out = out + visualizeCharacterCode(code);
      i = i + 2;
    } else if (i + 1 < n && value.charAt(i) == "%" && value.charAt(i + 1) == "c") {
      int delta = 0;
      int j = i + 2;
      if (j < n && (value.charAt(j) == "+" || value.charAt(j) == "-")) {
        string sign = value.charAt(j);
        j = j + 1;
        int num = 0;
        bool any = false;
        while (j < n) {
          int c = value.charCodeAt(j);
          if (c >= 48 && c <= 57) {
            num = num * 10 + (c - 48);
            any = true;
            j = j + 1;
          } else {
            break;
          }
        }
        if (any) {
          if (sign == "-") {
            delta = 0 - num;
          } else {
            delta = num;
          }
          i = j;
        } else {
          i = i + 2;
        }
      } else {
        i = i + 2;
      }
      int idx = startOffset + delta;
      string ch = "";
      if (idx >= 0 && idx < document.length) {
        ch = document.charAt(idx);
      }
      out = out + visualizeCharacter(ch);
    } else {
      out = out + value.charAt(i);
      i = i + 1;
    }
  }
  return out;
}

int ruleLevel(JsValue settings, string name) {
  JsValue setting = JS.get(settings, name);
  if (JS.isUndefined(setting) || JS.isNullish(setting)) {
    return 1;
  }
  if (JS.typeOf(setting) == "number") {
    return JS.number(setting).toInt();
  }
  if (setting.truthy()) {
    return 1;
  }
  return 0;
}

JsValue fatalOf(int level) {
  if (level == 2) {
    return true;
  }
  if (level == 1) {
    return false;
  }
  return JS.undefined();
}

void handleParseError(JsValue error, string document, JsValue settings, JsValue onerror) {
  string code = "";
  JsValue codeVal = JS.get(error, "code");
  if (codeVal is string) {
    code = codeVal;
  }
  string name = camelcase(code);
  int level = ruleLevel(settings, name);
  if (level == 0) {
    return;
  }
  ParseErrorInfo? info = parseErrorInfo(name);
  if (info == null) {
    return;
  }
  string reason = formatTemplate(info.reason, document, error);
  JsValue place = JS.object(
    "start",
    JS.object("line", JS.get(error, "startLine"), "column", JS.get(error, "startCol"), "offset", JS.get(error, "startOffset")),
    "end",
    JS.object("line", JS.get(error, "endLine"), "column", JS.get(error, "endCol"), "offset", JS.get(error, "endOffset"))
  );
  JsValue message = createMessage(reason, place, code, "hast-util-from-html");
  JS.set(message, "fatal", fatalOf(level));
  JS.set(message, "note", formatTemplate(info.description, document, error));
  if (!info.url) {
    JS.set(message, "url", JS.undefined());
  } else {
    JS.set(message, "url", ERROR_BASE + code);
  }
  JS.call(onerror, JS.undefined(), message);
}

export JsValue fromHtml(JsValue value, JsValue options) {
  JsValue settings = options;
  if (JS.isUndefined(options) || JS.isNullish(options)) {
    settings = JS.object();
  }
  string document = asDoc(value);
  JsValue onerror = JS.get(settings, "onerror");
  JsValue parseOptions = JS.object();
  JS.set(parseOptions, "sourceCodeLocationInfo", true);
  JS.set(parseOptions, "scriptingEnabled", false);
  if (onerror.truthy() && JS.typeOf(onerror) == "function") {
    JS.set(parseOptions, "onParseError", JS.method1((JsValue _s, JsValue error) => {
      handleParseError(error, document, settings, onerror);
      return JS.undefined();
    }));
  } else {
    JS.set(parseOptions, "onParseError", JS.invoke(JSON, "parse", "null"));
  }
  JsValue p5 = JS.undefined();
  if (JS.get(settings, "fragment").truthy()) {
    p5 = parseFragment(document, parseOptions);
  } else {
    p5 = parseDocument(document, parseOptions);
  }
  JsValue file = value;
  if (value is string || JS.isUndefined(value) || JS.isNullish(value) || JS.typeOf(value) != "object") {
    file = JS.object();
    JS.set(file, "value", document);
    JS.set(file, "toString", JS.method0((JsValue _s) => {
      return document;
    }));
  }
  JsValue next = JS.object();
  JS.set(next, "file", file);
  JS.set(next, "space", JS.get(settings, "space"));
  JS.set(next, "verbose", JS.get(settings, "verbose"));
  return fromParse5(p5, next);
}
