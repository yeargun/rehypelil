import {
  NULL,
  copyArray,
  isErrorInstance,
  isFn,
  setIndex,
  throwType
} from "./host.lil";

JsValue wrapMiddleware(JsValue middleware, JsValue callback) {
  JsValue state = JS.object();
  JS.set(state, "called", false);

  JsValue doneFn = JS.methodRest((JsValue _s, JsValue outArgs) => {
    if (JS.get(state, "called").truthy()) {
      return JS.undefined();
    }
    JS.set(state, "called", true);
    JS.apply(callback, JS.undefined(), outArgs);
    return JS.undefined();
  });

  JsValue thenFn = JS.method1((JsValue _s, JsValue value) => {
    JsValue packed = JS.array();
    JS.push(packed, NULL);
    JS.push(packed, value);
    JS.apply(doneFn, JS.undefined(), packed);
    return JS.undefined();
  });

  return JS.methodRest((JsValue self, JsValue parameters) => {
    JsValue params = copyArray(parameters);
    bool fnExpectsCallback = JS.number(middleware["length"]) > JS.number(params["length"]);
    if (fnExpectsCallback) {
      JS.push(params, doneFn);
    }
    JsValue result = JS.undefined();
    try {
      result = JS.apply(middleware, self, params);
    } catch (JsValue exception) {
      if (fnExpectsCallback && JS.get(state, "called").truthy()) {
        throw exception;
      }
      JsValue errPack = JS.array();
      JS.push(errPack, exception);
      JS.apply(doneFn, JS.undefined(), errPack);
      return JS.undefined();
    }
    if (!fnExpectsCallback) {
      if (result.truthy() && JS.get(result, "then").truthy() && isFn(JS.get(result, "then"))) {
        JS.invoke(result, "then", thenFn, doneFn);
      } else if (isErrorInstance(result)) {
        JsValue errPack = JS.array();
        JS.push(errPack, result);
        JS.apply(doneFn, JS.undefined(), errPack);
      } else {
        JS.call(thenFn, JS.undefined(), result);
      }
    }
    return JS.undefined();
  });
}

JsValue troughRun(JsValue self, JsValue args) {
  JsValue values = copyArray(args);
  JsValue callback = JS.pop(values);
  if (!isFn(callback)) {
    throwType("Expected function as last argument, not " + JS.string(callback));
  }
  JsValue ctx = JS.object();
  JS.set(ctx, "middlewareIndex", -1.0);
  JS.set(ctx, "values", values);
  JS.set(ctx, "fns", JS.get(self, "fns"));
  JS.set(ctx, "callback", callback);

  JsValue nextFn = JS.undefined();
  nextFn = JS.methodRest((JsValue _s, JsValue nextArgs) => {
    JsValue fns = JS.get(ctx, "fns");
    float mid = JS.number(JS.get(ctx, "middlewareIndex")) + 1.0;
    JS.set(ctx, "middlewareIndex", mid);
    JsValue fn = JS.undefined();
    int midInt = mid.toInt();
    if (midInt < fns.length.toInt()) {
      fn = fns[midInt];
    }
    JsValue error = JS.undefined();
    JsValue output = JS.array();
    int na = nextArgs.length.toInt();
    if (na > 0) {
      error = nextArgs[0];
      int j = 1;
      while (j < na) {
        JS.push(output, nextArgs[j]);
        j = j + 1;
      }
    }
    if (error.truthy()) {
      JS.call(JS.get(ctx, "callback"), JS.undefined(), error);
      return JS.undefined();
    }
    JsValue currentValues = JS.get(ctx, "values");
    int index = -1;
    int vlen = currentValues.length.toInt();
    while (true) {
      index = index + 1;
      if (index >= vlen) {
        break;
      }
      JsValue slot = JS.undefined();
      if (index < output.length.toInt()) {
        slot = output[index];
      }
      if (JS.isNullish(slot)) {
        setIndex(output, index, currentValues[index]);
      }
    }
    JS.set(ctx, "values", output);
    if (isFn(fn)) {
      JsValue wrapped = wrapMiddleware(fn, nextFn);
      JS.apply(wrapped, JS.undefined(), output);
    } else {
      JsValue packed = JS.array();
      JS.push(packed, NULL);
      int k = 0;
      int olen = output.length.toInt();
      while (k < olen) {
        JS.push(packed, output[k]);
        k = k + 1;
      }
      JS.apply(JS.get(ctx, "callback"), JS.undefined(), packed);
    }
    return JS.undefined();
  });

  JsValue start = JS.array();
  JS.push(start, NULL);
  int si = 0;
  int sl = values.length.toInt();
  while (si < sl) {
    JS.push(start, values[si]);
    si = si + 1;
  }
  JS.apply(nextFn, JS.undefined(), start);
  return JS.undefined();
}

JsValue troughUse(JsValue self, JsValue middleware) {
  if (!isFn(middleware)) {
    throwType("Expected `middelware` to be a function, not " + JS.string(middleware));
  }
  JS.push(JS.get(self, "fns"), middleware);
  return self;
}

JsValue troughRunMethod = JS.methodRest(troughRun);
JsValue troughUseMethod = JS.method1(troughUse);

export JsValue trough() {
  JsValue pipeline = JS.object();
  JS.set(pipeline, "fns", JS.array());
  JS.set(pipeline, "run", troughRunMethod);
  JS.set(pipeline, "use", troughUseMethod);
  return pipeline;
}
