import { htmlSchemaBlob, svgSchemaBlob } from "./schema-data.lil";
import { Space, validDataName } from "./types.lil";

export struct Info {
  string property;
  string attribute;
  string flags;
}

Map<string, Info> htmlSchema = new Map<string, Info>();
Map<string, Info> svgSchema = new Map<string, Info>();
bool schemaReady = false;

void addLine(Map<string, Info> schema, string line) {
  int first = -1;
  int second = -1;
  int i = 0;
  int n = line.length;
  while (i < n) {
    if (line.charAt(i) == "|") {
      if (first < 0) {
        first = i;
      } else if (second < 0) {
        second = i;
      }
    }
    i = i + 1;
  }
  if (first < 0 || second < 0) {
    return;
  }
  string prop = line.slice(0, first);
  string attr = line.slice(first + 1, second);
  string flags = line.slice(second + 1);
  Info info = Info{prop, attr, flags};
  schema.set(prop.toLowerCase(), info);
  schema.set(attr.toLowerCase(), info);
}

void loadBlob(Map<string, Info> schema, string blob) {
  int start = 0;
  int n = blob.length;
  int i = 0;
  while (i <= n) {
    if (i == n || blob.charAt(i) == "\n") {
      if (i > start) {
        addLine(schema, blob.slice(start, i));
      }
      start = i + 1;
    }
    i = i + 1;
  }
}

void ensureSchema() {
  if (schemaReady) {
    return;
  }
  schemaReady = true;
  loadBlob(htmlSchema, htmlSchemaBlob);
  loadBlob(svgSchema, svgSchemaBlob);
}

pure string kebabCap(string ch) {
  return "-" + ch.toLowerCase();
}

pure string restToKebab(string rest) {
  string out = "";
  int i = 0;
  int n = rest.length;
  while (i < n) {
    string ch = rest.charAt(i);
    int c = rest.charCodeAt(i);
    if (c >= 65 && c <= 90) {
      out = out + kebabCap(ch);
    } else {
      out = out + ch;
    }
    i = i + 1;
  }
  return out;
}

pure bool hasDashLower(string rest) {
  int i = 0;
  int n = rest.length;
  while (i < n - 1) {
    if (rest.charAt(i) == "-") {
      int c = rest.charCodeAt(i + 1);
      if (c >= 97 && c <= 122) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

pure string dashToCamelChunk(string rest) {
  string out = "";
  int i = 0;
  int n = rest.length;
  while (i < n) {
    if (i < n - 1 && rest.charAt(i) == "-") {
      int c = rest.charCodeAt(i + 1);
      if (c >= 97 && c <= 122) {
        out = out + rest.charAt(i + 1).toUpperCase();
        i = i + 2;
      } else {
        out = out + rest.charAt(i);
        i = i + 1;
      }
    } else {
      out = out + rest.charAt(i);
      i = i + 1;
    }
  }
  return out;
}

export Info findInfo(Space space, string value) {
  ensureSchema();
  Map<string, Info> schema = htmlSchema;
  if (space == Space.Svg) {
    schema = svgSchema;
  }
  string lowered = value.toLowerCase();
  Info? known = schema.get(lowered);
  if (known != null) {
    return known;
  }
  string propertyName = value;
  string attributeName = value;
  if (lowered.length > 4 && lowered.slice(0, 4) == "data" && validDataName(value)) {
    if (value.length > 4 && value.charAt(4) == "-") {
      string rest = dashToCamelChunk(value.slice(5));
      if (rest.length > 0) {
        propertyName = "data" + rest.charAt(0).toUpperCase() + rest.slice(1);
      } else {
        propertyName = "data";
      }
    } else {
      string rest = value.slice(4);
      if (!hasDashLower(rest)) {
        string dashes = restToKebab(rest);
        if (dashes.length == 0 || dashes.charAt(0) != "-") {
          dashes = "-" + dashes;
        }
        attributeName = "data" + dashes;
      }
    }
  }
  return Info{propertyName, attributeName, ""};
}

export pure bool flagHas(string flags, string ch) {
  int i = 0;
  while (i < flags.length) {
    if (flags.charAt(i) == ch) {
      return true;
    }
    i = i + 1;
  }
  return false;
}
