import { Error, Number, Object, String } from "../../unified/host.lil";

export extern class ToHtmlOptions {
  JsValue allowDangerousHtml;
  JsValue allowDangerousCharacters;
  JsValue allowParseErrors;
  JsValue bogusComments;
  JsValue characterReferences;
  JsValue closeEmptyElements;
  JsValue closeSelfClosing;
  JsValue collapseEmptyAttributes;
  JsValue omitOptionalTags;
  JsValue preferUnquoted;
  JsValue quote;
  JsValue quoteSmart;
  JsValue space;
  JsValue tightAttributes;
  JsValue tightCommaSeparatedLists;
  JsValue tightDoctype;
  JsValue tightSelfClosing;
  JsValue upperDoctype;
  JsValue voids;
}

export enum Space { Html, Svg }

export struct CharacterReferences {
  bool omitOptionalSemicolons;
  bool useNamedReferences;
  bool useShortestReferences;
}

export struct Settings {
  bool omitOptionalTags;
  bool allowParseErrors;
  bool allowDangerousCharacters;
  bool quoteSmart;
  bool preferUnquoted;
  bool tightAttributes;
  bool upperDoctype;
  bool tightDoctype;
  bool bogusComments;
  bool tightCommaSeparatedLists;
  bool tightSelfClosing;
  bool collapseEmptyAttributes;
  bool allowDangerousHtml;
  JsValue voids;
  CharacterReferences characterReferences;
  bool closeSelfClosing;
  bool closeEmptyElements;
}

export bool hasOwn(JsValue obj, string key) {
  return JS.call(JS.get(JS.get(Object, "prototype"), "hasOwnProperty"), obj, key).truthy();
}

export string jsString(JsValue value) {
  if (value is string) {
    return value;
  }
  if (JS.isUndefined(value)) {
    return "undefined";
  }
  if (JS.isNullish(value)) {
    return "null";
  }
  return JS.string(JS.call(String, JS.undefined(), value));
}

export string stringField(JsValue node, string key) {
  JsValue value = JS.get(node, key);
  if (value is string) {
    return value;
  }
  return "";
}

export bool optionFlag(JsValue value, bool fallback) {
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return fallback;
  }
  return value.truthy();
}

export bool isNaNNumber(JsValue value) {
  return JS.call(JS.get(Number, "isNaN"), JS.undefined(), value).truthy();
}

export bool isJsNumber(JsValue value) {
  return JS.typeOf(value) == "number";
}

export string fromCharCode(int code) {
  return jsString(JS.call(JS.get(String, "fromCharCode"), String, code));
}

export int childCount(JsValue nodes) {
  if (!JS.isArray(nodes)) {
    return 0;
  }
  return JS.number(JS.get(nodes, "length")).toInt();
}

export JsValue childrenOf(JsValue parent) {
  if (JS.isUndefined(parent) || JS.isNullish(parent)) {
    return JS.array();
  }
  JsValue kids = JS.get(parent, "children");
  if (JS.isArray(kids)) {
    return kids;
  }
  return JS.array();
}

export pure bool defaultVoidName(string tag) {
  return tag == "area" || tag == "base" || tag == "basefont" || tag == "bgsound" || tag == "br" || tag == "col" || tag == "command" || tag == "embed" || tag == "frame" || tag == "hr" || tag == "image" || tag == "img" || tag == "input" || tag == "keygen" || tag == "link" || tag == "meta" || tag == "param" || tag == "source" || tag == "track" || tag == "wbr";
}

export bool voidsIncludes(JsValue voids, string tag) {
  if (JS.isUndefined(voids) || JS.isNullish(voids) || !JS.isArray(voids)) {
    return defaultVoidName(tag);
  }
  int n = childCount(voids);
  int i = 0;
  while (i < n) {
    if (jsString(voids[i]) == tag) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

export pure bool isBlankText(string value) {
  int n = value.length;
  int i = 0;
  while (i < n) {
    int c = value.charCodeAt(i);
    if (c != 9 && c != 10 && c != 12 && c != 13 && c != 32) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

export bool isWhitespaceNode(JsValue node) {
  if (node is string) {
    return isBlankText(node);
  }
  if (JS.isUndefined(node) || JS.isNullish(node) || JS.typeOf(node) != "object") {
    return false;
  }
  if (stringField(node, "type") == "text") {
    return isBlankText(jsString(JS.get(node, "value")));
  }
  return false;
}

export pure int countChar(string value, string ch) {
  int n = 0;
  int i = 0;
  int len = value.length;
  while (i < len) {
    if (value.charAt(i) == ch) {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

export pure bool charInSet(string ch, string set) {
  int i = 0;
  int n = set.length;
  while (i < n) {
    if (set.charAt(i) == ch) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

export pure bool validDataName(string value) {
  if (value.length < 5) {
    return false;
  }
  if (value.toLowerCase().slice(0, 4) != "data") {
    return false;
  }
  int i = 4;
  int n = value.length;
  while (i < n) {
    int c = value.charCodeAt(i);
    bool ok = false;
    if (c >= 48 && c <= 57) {
      ok = true;
    } else if (c >= 65 && c <= 90) {
      ok = true;
    } else if (c >= 97 && c <= 122) {
      ok = true;
    } else if (c == 45 || c == 95 || c == 46 || c == 58) {
      ok = true;
    }
    if (!ok) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

export void fail(string message) {
  throw JS.construct(Error, message);
}
